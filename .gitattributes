* linguist-vendored
*.js linguist-vendored=false

# Line endings are decided here, not by each git's core.autocrlf.  This repo is
# used from Git for Windows (autocrlf=true: checks out CRLF) and from MSYS2's
# git (no autocrlf: checks out LF).  Without this they disagree about what is
# modified - after a branch switch MSYS2's git listed ~100 untouched files.
# text=auto stores text with LF and lets each git check out its own native
# ending while comparing against LF, so both see a clean tree.
* text=auto

# Binaries: never convert.
*.rom binary
*.ROM binary
*.dsk binary
*.com binary
*.COM binary
*.bin binary
*.BIN binary
*.SYS binary
*.pof binary
*.sof binary
*.png binary
*.jpg binary
*.pdf binary

# Shell scripts must keep LF endings.  Several of these run on the Raspberry Pi
# (msxpi-tcpip-setup.sh) or under Git Bash / WSL, and CRLF breaks them outright
# - the shebang picks up a stray \r and the shell reports "bad interpreter" or
# "$'\r': command not found".  Windows tooling reintroduces CRLF very easily:
# Python's open(...,'w') translates \n to \r\n by default, which is exactly how
# these got broken once already.
*.sh        text eol=lf
software/build text eol=lf

# Batch files run by cmd need CRLF on checkout.
*.bat       text eol=crlf

# What the MSX reads.  GitHub serves these to the MSX updater byte for byte,
# and the build copies them onto the disk images byte for byte, so the STORED
# bytes must already be what the MSX needs: CRLF, and for INL.CFG a trailing
# Ctrl-Z as well.  Without either, InterNestor Lite reports "Cannot execute this
# command from a configuration file" and then loops printing its banner - see
# UNAPI/crlf.py.  -text keeps them exactly as committed.  These lines must stay
# after the *.bat rule above, which they override.
software/target/*.BAS -text
software/target/*.bat -text
software/target/*.ini -text
software/target/*.CFG -text
