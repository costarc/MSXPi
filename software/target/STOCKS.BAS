10 CLEAR 200,49152
20 SCREEN 0
30 WIDTH 80
40 KEY 1,"1 Chart":KEY 2,"2 Exit":KEY 3,"": KEY 4,"": KEY 5,"":KEY ON
100 REM --- Comma-separated ticker list ---
110 TL$ = "AZN.L,CCH.L,GLEN.L,LGEN.L,NG.L,PHSP.L,MSTR,SAIL,AXP,JDG.L,VUSA.L,EXPN.L,DEC.L,BTC-USD,XRP-USD,CRO-USD"

120 CALL MSXPI("0,D000,STOCK STARTCACHE 600")

160 REM --- Display layout ---
161 SR = 6
162 SC = 1

170 ' HEADER
172 ON KEY GOSUB 1000,9999
175 CLS
176 GOSUB 11000

180 REM --- Main update loop ---
190 B = &HD000
195 KEY 1,"Refreshing...": KEY 2, "":KEY (1) OFF:KEY (2) OFF
200 CALLMSXPI("2,"+HEX$(B)+",STOCK FETCHLIST "+TL$)

220 REM --- Streaming data until end of buffer
230 ROW = SR
250 SZ = PEEK(B+1) + 256*PEEK(B+2)
255 LOCATE 0,6
260 FOR J = B+3 TO B+SZ+2
270   C = PEEK(J)

320   IF C = 10 THEN  PRINT:GOTO 370
360   PRINT CHR$(C);
370 NEXT J
380 KEY 1,"1 Chart":KEY 2,"2 Exit":KEY (1) ON:KEY (2) ON

400 TIME=0
410 IF TIME<720 THEN GOTO 410
420 GOTO 190

1000 KEY OFF:LOCATE 0,24
1010 Z$=INKEY$:IF Z$<>"" THEN GOTO 1010
1020 INPUT "Tick:";TK$
1030 SCREEN 2
1040 GOSUB 2000
1050 SCREEN 0
1060 GOSUB 11000
1070 KEY ON
1078 RETURN

2000 RETURN

9999 LOCATE 0,24
10000 CALL MSXPI("0,D000,STOCK STOPCACHE")
10010 Z$=INKEY$:IF Z$<>"" THEN GOTO 10010
10020 END

11000 REM --- Header ---
11171 LOCATE 0,2: PRINT "MSXPi STOCK WATCHLIST"
11172 LOCATE 0,3: PRINT "====================="
11173 LOCATE 0,4: PRINT "SYMBOL      Last      Open      High       Low     Close      Volume"
11174 LOCATE 0,5: PRINT "--------------------------------------------------------------------"
11180 RETURN