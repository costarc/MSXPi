  "patches": [
    {
      "offset": 19,
      "expected": "32ee40",
      "replace": "000000",
      "reason": "4013h: Anti-copy write ld (40EEh),a (a RET over a DJNZ): a no-op on a cartridge, harmful in RAM"
    },
    {
      "offset": 29,
      "expected": "cd9551",
      "replace": "cd43c1",
      "reason": "401Dh: Sound tick per interrupt -> PN_IRQ counts it; the stub ticks the driver"
    },
    {
      "offset": 51,
      "expected": "cde347",
      "replace": "cdf0c3",
      "reason": "4033h: TICK site: the pad reader, once per frame -> PN_TICK (the exchange), then the reader"
    },
    {
      "offset": 64,
      "expected": "3e003205e0",
      "replace": "cd04c40000",
      "reason": "4040h: The frame catch-up: the busy flag cleared, or the next frame at once when an interrupt went by during PN_TICK -> isrEnd"
    },
    {
      "offset": 74,
      "expected": "fc9551",
      "replace": "fc43c1",
      "reason": "404Ah: Catch-up sound tick (an interrupt pending after the frame) -> PN_IRQ"
    },
    {
      "offset": 82,
      "expected": "22f840",
      "replace": "000000",
      "reason": "4052h: Anti-copy write ld (40F8h),hl (0000h over the operand of a JP): same"
    },
    {
      "offset": 117,
      "expected": "1940",
      "replace": "06c5",
      "reason": "4075h: H.KEYI hook (ld hl,4019h at 4074h) -> the transport's XIRQ, which jumps to 4019h"
    },
    {
      "offset": 683,
      "expected": "cd004857cd1248b2",
      "replace": "cdf6c30000000000",
      "reason": "42ABh: Menu reader: player 1's byte of this frame"
    },
    {
      "offset": 935,
      "expected": "cd004857cd1248b2",
      "replace": "cdf6c30000000000",
      "reason": "43A7h: Title menu reader: player 1's byte of this frame"
    },
    {
      "offset": 973,
      "expected": "3202e0",
      "replace": "cdfec3",
      "reason": "43CDh: Title menu start: both choices are the 2 player mode"
    },
    {
      "offset": 2022,
      "expected": "cd004857cd1248b2",
      "replace": "cdf6c30000000000",
      "reason": "47E6h: Player 1's pad: the byte of this frame"
    },
    {
      "offset": 2117,
