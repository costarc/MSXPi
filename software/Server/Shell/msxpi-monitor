#!/bin/bash
# 2023-04-10 : Removed WhatsApp monitor
#              Changed sleep from 5 to 2 seconds
# 2017-11-23 : Added ramdisk setup
# 2017-11-18 : Added switch to python or C version
# 2026-09-02 : Added TCPIP/UNAPI setup; Added logging to /var/log/msxpi.log

MSXPIHOME=/home/pi/msxpi
FILELIST="pplay.sh"
USEROOT=$(/usr/bin/whoami | /bin/grep -c "root")
UNAPISETUP="/home/pi/msxpi/msxpi-tcpip-setup.sh"
MSXPI_ROOT_LOG="/var/log/msxpi.log"

# Native GPIO payload engine (burst transfers), see Server/Python/src/native/
# README.md. On by default; exported so every server this script (re)starts
# inherits it. Override with Environment=MSXPI_NATIVE_GPIO=0 in the systemd
# unit. If native/libmsxpi_gpio.so is missing the server falls back to Python
# GPIO and logs "native engine unavailable".
export MSXPI_NATIVE_GPIO="${MSXPI_NATIVE_GPIO:-1}"

if [[ -x "$UNAPISETUP" ]]; then
    echo "$(date) Starting root script $UNAPISETUP" >> "$MSXPI_ROOT_LOG"
    sudo nohup "$UNAPISETUP" >> "$MSXPI_ROOT_LOG" 2>&1 &
else
    echo "$(date) $UNAPISETUP not found or not executable" >> "$MSXPI_ROOT_LOG"
fi

# Ensure log file exists and user pi has full write permissions
if [[ ! -f "$MSXPI_ROOT_LOG" ]]; then
    sudo touch "$MSXPI_ROOT_LOG"
fi
sudo chown pi:pi "$MSXPI_ROOT_LOG"
chmod 664 "$MSXPI_ROOT_LOG"

if [[ $USEROOT -eq 1 ]];then
    PREFIX="sudo -i -u pi "
    OSCMDPREFIX=
else
    PREFIX=
    OSCMDPREFIX="sudo "
fi

pid=$(ps -ef | grep '[m]sxpi-server.py' | awk '{print $2}')
if [[ -n "$pid" ]]; then
    sudo kill -9 $pid
else
    echo "No matching msxpi-server.py process found."
fi

MSXPISERVER="/usr/bin/python3 -u $MSXPIHOME/msxpi-server.py"

# check if msxpi files are already installed in ramdisk
if [[ ! -e /media/ramdisk/senddatablock.msx ]]; then
    if [[ $(/bin/df /media/ramdisk | /bin/grep -c ramdisk) -eq 0 ]]; then
        if [[ ! -e /media/ramdisk/ ]]; then
            ${OSCMDPREFIX}mkdir -p /media/ramdisk
        fi
        echo y | ${OSCMDPREFIX}/sbin/mke2fs -q -m 0 /dev/ramdisk 1m
        ${OSCMDPREFIX}/bin/mount /dev/ramdisk /media/ramdisk
    fi
fi

${OSCMDPREFIX}chown -R pi:pi /media/ramdisk

for file in $FILELIST
do
    cp -p $MSXPIHOME/$file /media/ramdisk/
done

R=$(echo $1 | /bin/grep -c "\-t")
if [[ $# -eq 1 && $R -eq 1 ]]; then
    echo "Entering test mode"
    $MSXPISERVER
    exit 0
fi

echo "Restarting msxpi-server"
$MSXPISERVER >> "$MSXPI_ROOT_LOG" 2>&1 &

rm -f /home/pi/msxpi/msxpi-update*

while :
do
    sleep 2
    state=$(ps -ef | grep '[m]sxpi-server' | wc -l)

    if [[ $state -eq 0 ]];then
        echo "Restarting msxpi-server"
        $MSXPISERVER >> "$MSXPI_ROOT_LOG" 2>&1 &

        sleep 2
        
        # Check recent log entries for initialization failure
        if tail -n 20 "$MSXPI_ROOT_LOG" | grep -q "initialisation failed"; then
            echo "$(date) Initialization failed detected. Shutting down system." >> "$MSXPI_ROOT_LOG"
            sudo shutdown -h now
        fi
    fi
done