; scc patch table

scctable:
        ; Space Manbow
        defb 41                 ; game number
        defw 4c15h              ; return for SCC enable
        defw 4c15h              ; return for SCC disable
        defb 1                  ; one call for enable
        defb 01ch               ; page 1Ch
        defw 0430h              ; offset 430h
        defb 1                  ; one call for disable
        defb 01ch               ; page 1Ch
        defw 0436h              ; offset 436h
        defb 255                ; end of patch
        ; Nemesis 2
        defb 4
        defw 0
        defw 0
        defb 4
        defb 4
        defw 5bdh
        defw 5f6h
        defw 11d7h
        defw 1238h
        defb 4
        defb 4
        defw 5c6h
        defw 5ffh
        defw 11deh
        defw 1251h
        defb 255                ; end of patch
        ; Nemesis 2 beta
        ; SCC on: 8121, 8151, 8e0a, 8e6d, 15f97 (no off!), 17f97 (no off!)
        ; SCC off: 812c, 815c, 8e13, 8e86
        defb 5
        defw 0
        defw 0
        defb 4
        defb 4
        defw 0121h, 0151h, 0e0ah, 0e6dh
        defb 4
        defb 4
        defw 012ch, 015ch, 0e13h, 0e86h
        defb 255                ; end of patch
        ; F1 Spirit
        ; SCC on: 1ada5h, 1ae06h
        ; SCC off: 1adach, 1ae1fh
        defb 12
        defw 0,0
        defb 2
        defb 0dh
        defw 0da5h, 0e06h
        defb 2
        defb 0dh
        defw 0dach, 0e1fh
        defb 255                ; end of patch
        ; A1 Spirit
        ; SCC on: 1ae25h, 1ae86h
        ; SCC off: 1ae2ch, 1ae9fh
        defb 13
        defw 0,0
        defb 2
        defb 0dh
        defw 0e25h, 0e86h
        defb 2
        defb 0dh
        defw 0e2ch, 0e9fh
        defb 255                ; end of patch
        ; Salamander
        ; SCC on: 85c4h, 8606h, 934ah, 93abh
        ; SCC off: 85cdh, 8622h, 9351h, 93c4h
        defb 7                  ; game number
        defw 0,0                ; no specific return for SCC enable/disable
        defb 4                  ; 4 patchs for SCC enable
        defb 4                  ; page 4
        defw 5c4h, 606h, 134ah, 13abh
        defb 4                  ; 4 patches for SCC disable
        defb 4                  ; page 4
        defw 5cdh, 622h, 1351h, 13c4h
        defb 255                ; end of patch
        ; Parodius
        ; SCC on: 821eh, 906eh, 90cfh
        ; SCC off: 824ch, 9075h, 90e8h
        defb 14                 ; game number
        defw 0,0                ; no specific return for SCC enable/disable
        defb 3                  ; 3 patches for SCC enable
        defb 4                  ; page 4
        defw 21eh, 106eh, 10cfh
        defb 3                  ; 3 patches for SCC disable
        defb 4                  ; page 5
        defw 24ch, 1075h, 10e8h
        defb 255                ; end of patch
        ; Kings Valley II (MSX1, SCC)
        ; SCC on: 8026h, 822fh, 82b6h, 8eb0h, 8f11h 
        ; SCC off: 802fh, 823ah, 82d0h, 8eb7h, 8f2ah
