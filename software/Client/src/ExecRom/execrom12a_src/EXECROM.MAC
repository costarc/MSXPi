        ; Pennant Race
        db 37
        defw 0757h
        defw pen1tab

        ; Pennant Race II
        db 38
        defw 0766h
        defw pen2tab

        ; Salamander
        db 7
        defw 0758h
        defw salatab

        ; Parodius
