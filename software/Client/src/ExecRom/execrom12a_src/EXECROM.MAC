        db 3,6,4                ;                         .
        db 1,2,5                ;                         .
        db 2,3,6                ;                         .
        db 5,2,1                ;                         .
        db 3,5,7                ;                         .
        db 6,3,2                ;                         .
        db 7,4,2                ;                         .
        db 7,6,2                ;                         .
        db 7,7,4                ;                         light yellow
        db 1,4,2                ;                         yellow
        db 5,2,4                ;                         magenta
        db 5,5,5                ;                         gray
        db 7,7,7                ;                         white
                                
; megaroms checksum table
; Original idea by Ricardo Bittencourt, 1998
; table format: ROM flag, checksum (16 bits), cartridge name address
;               ROM flag: 000SRRRR
;                            |----
;                            | |
;                            | +--> ROM type (0-5)
;                            +----> 1 if SCC game, 0 if not
; checksum is just a sum of the first 64 16-bits words of MegaROM mod 65536

megatbl:db 0                    ; 1942                                  00
        dw 0f349h
        db '1942 (MSX1)$'        
        db 0                    ; Final Zone
        dw 01f9fh
        db 'Final Zone$'
        db 0                    ; The Maze of Galious
        dw 025adh
        db 'The Maze of Galious$'
        db 0                    ; Nemesis I
        dw 079f1h
        db 'Nemesis I$'     
nem2tab:db 10h                  ; Nemesis II (SCC)
        dw 06684h
        db 'Nemesis II$'         
ne2btab:db 10h                  ; Nemesis II beta (SCC)
        dw 0a9fch
        db 'Nemesis II beta$'
nem3tab:db 10h                  ; Nemesis III (SCC)
        dw 056b2h
        db 'Nemesis III$'        
salatab:db 10h                  ; Salamander (SCC)
        dw 0132ah               
        db 'Salamander$'
        db 0                    ; Super Laydock
        dw 02f03h               ; obs.: right MegaROM type is #4
        db 'Syper Laydock$'     ;       but ExecROM uses #0 due to patchfile
