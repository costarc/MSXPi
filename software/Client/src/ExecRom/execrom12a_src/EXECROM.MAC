        defw quartab

        defb 255                ; end of table

; gamemaster2 megarom to mapper conversion table (without disk usage)
; table format: page block,page block,...,0FFh
;               page block format: page,number of blocks,<blocks>
;               block format:address,number of bytes,<bytes>

gm2cnv: db 2,40
