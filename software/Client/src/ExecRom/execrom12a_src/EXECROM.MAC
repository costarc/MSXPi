;
; ------------------
; ExecROM ROM types:
; ------------------
; 00 - Konami 8kb       01 - Konami 16kb          02 - Konami5 8kb
; 03 - Konami4 8kb      04 - ASCII 8kb            05 - ASCII 16kb
;
; --------------------
; Patchfile structure:
; --------------------
; Header: string ExecROM patchfile
;         byte   1Ah      
;         byte   XY       - version of patch file: X.Y
; Body  : byte   WW       - number of patch blocks
;         byte   EE       - identify if patch is essential (255) (no ask)
; Patch : string ....     - patch definition in interrogative form (Y/N)
;         byte   24       - string definition end
;         byte   TT       - data modification block size in bytes
;         word   AABB     - modification initial address (page begining: 0000)
;         byte   PP       - page (8k) to modify (0 to 16/32k ROM)
;         bytes  ....     - bytes do modify (number of bytes: TT)
; ** File ends with the 00 byte
; Example: 'ExecROM patchfile'
;          1A                             // signature
;          10                             // version (1.0)
;          01                             // this patch: one block
;          FF                             // patch is essential (no ask)
;          'Ignore initialization'        // patch definition
;          24                             // patch definition end
;          03 10 40 01                    // 3 bytes, address 4010h, page 01h
;          28 54 72                       // patch data
;          02                             // this patch: two blocks
;          00                             // patch is optative
;          'Skip intro screen'            // patch definition
;          24                             // patch definition end
;          02 23 50 10                    // 2 bytes, address 5023h, page 10h
;          56 8A                          // patch data
;          01 14 60 05 56 8A              // 1 byte, address 6014h, page 05h
;          C3                             // patch data
;          00                             // end of file
;
; -----------------------------------
; MegaROM types, banks and addresses:
; -----------------------------------
; This information was compiled from infos by Sean Young and the source code
; of fMSX for MS-DOS by Marcel de Kogel and original fMSX by Marat Fayzullin
;
; **Konami 8Kb, fMSX option -rom 0**      **Konami 16Kb, fMSX option -rom 1** 
;   Banks:                                  Banks:
;    bank 1: 4000h - 5FFFh                   bank 1: 4000h - 7FFFh
;    bank 2: 6000h - 7FFFh                   bank 2: 8000h - BFFFh
;    bank 3: 8000h - 9FFFh
;    bank 4: A000h - BFFFh
;   Adresses:                               Adresses:
;    bank 1: 4000h-5FFFh                     bank 1: 4000h-7FFFh
;    bank 2: 6000h-7FFFh                     bank 2: 8000h-BFFFh
;    bank 3: 8000h-9FFFh
;    bank 4: A000h-BFFFh
;   
; **Konami5 8Kb, fMSX option -rom 2**     **Konami4 8Kb, fMSX option -rom 3** 
;   Banks:                                  Banks:
;    bank 1: 4000h - 5FFFh                   bank 1: 4000h - 5FFFh
;    bank 2: 6000h - 7FFFh                   bank 2: 6000h - 7FFFh
;    bank 3: 8000h - 9FFFh                   bank 3: 8000h - 9FFFh
;    bank 4: A000h - BFFFh                   bank 4: A000h - BFFFh
;   Adresses:                               Adresses:
;    bank 1: 5000h-57FFh                     bank 1: 4000h (no use on Konami)
;    bank 2: 7000h-77FFh                     bank 2: 6000h
;    bank 3: 9000h-97FFh                     bank 3: 8000h
;    bank 4: B000h-B7FFh                     bank 4: A000h
;   
; **ASCII 8Kb, fMSX option -rom 4**       **ASCII 16Kb, fMSX option -rom 5**
;   Banks:                                  Banks:
;    bank 1: 4000h - 5FFFh                   bank 1: 4000h - 7FFFh
;    bank 2: 6000h - 7FFFh                   bank 2: 8000h - BFFFh
;    bank 3: 8000h - 9FFFh
;    bank 4: A000h - BFFFh
;   Adresses:                               Adresses:
;    bank 1: 6000h-67FFh                     bank 1: 6000h-6FFFh
;    bank 2: 6800h-6FFFh                     bank 2: 7000h-7FFFh
;    bank 3: 7000h-77FFh
;    bank 4: 7800h-7FFFh
;
; -----------
; Known bugs:
; -----------
;
; SCC detection: works on BrMSX (!), but crashes real MSX. Causes MG2 to crash on
;                Leonard's MSX (also on Chessa's MSX). Removed now.
; Option /X: causes MSX to crash when go to BASIC. Not debugged yet.


;   *** Program constants

resetflg equ 0f975h
em16kadd equ 0f414h
rlcadd   equ 0f976h
gm2subr  equ 0b000h
gm2hand  equ 0bf00h
gm2dosv  equ 0bf01h
gm2clrm  equ 0bf02h
gm2z80   equ 0bf03h
gm2mapp  equ 0bf04h
gm2fcb   equ 0bf50h
gm2cnvt  equ 0ba00h
gm2bias  equ gm2subr-gm2load-0103h
gm2bbbb  equ 0f750h+100                 ; avoid conflict with SCCADD
sccadd   equ 0f750h
pr1add   equ sccadd+sccresf-sccres

rtypesig equ 0f370h

;   *** Initial procedures

        org 0100h       ; MSX-DOS .COM programs load at 0x0100; the source
                        ; has no ORG directive at all, so zmac would
                        ; otherwise assemble from address 0 instead
start:  nop
        jr      title           ; Warn user if executed under MS-DOS
        defb    0BAh            ; MOV DX,MSG52
        defw    msg52
        defb    0B4h,09h        ; MOV AH,9
        defb    0CDh,21h        ; INT 21h
        defb    0CDh,20h        ; INT 20h

title:  in a,(0a8h)     ; save actual slot/subslot status
        ld (ppiset1),a  
        ld a,(0ffffh)
        ld (ppiset2),a
        ld a,255        ; test for
        call srchcom  
        jr nz,title1
        ld e,12         ; clear screen,
        call prtchr
        ld hl,010fh     ; set color to 15,1
        ld (0f3e9h),hl
        ld iy,0         ; set slot to 0 (ROM BIOS),
        ld ix,0062h     ; set call to CHGCLR,
        call 001ch      ; change screen color
title1: xor a           ; select slot 0 (ROM BIOS)
        ld hl,002dh     ; select address 002dh (MSX type)
        call 000ch      ; read address
        ld (msxver),a   ; save MSX version (1,2,2+,TR)
        call getr800    ; save R800 mode
        call set800     ; switch to R800 mode if TR
        ld de,msg1      ; print copyright
        call messg        
        call idendos    ; identify MSXDOS (1 or 2)
        ld a,(80h)      ; get command lenght
        or a            ; zero?
        jp z,help       ; show help if yes
        ld a,'h'        ; test for
        call srchco2    ; '/H' or '/h' command
        jp z,help       ; and
        ld a,'?'        ; '/?' command
        call srchcom
        jp z,help       ; and show help if requested
title2: ld a,(80h)
        ld e,a
        ld d,0          ; put lenght in DE
        ld hl,81h       ; get final character
        add hl,de
        ld (hl),0       ; set end to 0

;   *** Put file name in FCB, show MSX type, search MegaRAM, Mappper,
;       and SCC process /B, /Y, /G1, initialize option /G2, open ROM file, 
;       identify ROM type

file:   ld bc,255    
        ld a,32
        cpdr            ; find name beginning
        inc hl
        inc hl
        ld (fnamadr),hl ; save file name/path address
        call parsdir    ; parse ROM directory, HL=ROM filename
        call filen      ; put file name on FCB
optb:   xor a
        ld (resetflg),a
        ld a,'b'
        call srchco2    ; if option /B present,
        jr nz,opty
        ld a,255
        ld (resetflg),a ; set reset flag
opty:   ld a,'y'
        call srchco2    ; if option /Y present
        jr nz,initcfg
        ld a,255
        ld (yespatc),a  ; set /Y flag
initcfg:ld de,msg40
        call messg
        ld a,'n'
        call srchco2    ; if option /N present
        jr nz,initcf0
        ld a,1
        ld (rommode),a  ; set 'load in MegaRAM' flag
initcf0:call msxtype    ; print MSX type
        call ac2ptof    ; disable turbo in CIEL MSX2+ Turbo
        call dostype
        call nommd2     ; disable DOS2 mapper control if under MSXDOS2
        ld a,1          ; search for MegaRAM
        call findram    
        cp 255          ; found?
        jr z,initcf1
        ld (mrslt),a
        call shwmega    ; if yes, show location
        call setmrtp
        jr initcf2
initcf1:xor a
        ld (rommode),a  ; else set flag of load ROM in RAM
        ld de,msg12     ; and print not found message
        call messg
initcf2:xor a           ; search for Memory Mapper
        call findram    
        cp 255          ; found?
        ld (mpslt),a
        jr z,initcf3
        call shwmap     ; yes, show size/slot
        jr initcf4
initcf3:ld de,msg19     ; else print not found message
        call messg
initcf4:ld a,2          ; search for SCC
        call findram
        cp 255          ; not found?
        ld (sccslt),a
        ld de,msg63     ; warn user
        jr z,initcf5
        call shwscc     ; else show SCC location
        jr initcf6
initcf5:call messg
initcf6:ld a,'g'        ; verify '/G' option
        call srchco2
        jr nz,analyz
        ld a,(hl)
        cp '1'
        jp z,loadgm     ; and load Game Master I if requested (/G1)
        cp '2'
        jr nz,analyz    ; if option /G2 requested,
        ld a,1
        ld (gmload),a   ; set GameMaster2 load
        ld a,2
        ld (gmtype),a
        ld hl,gm2name
        ld (gmnadr),hl  ; set cartridge name
        ld de,msg61
        ld a,(mpslt)    ; there is memory mapper in the system?
        cp 255
        jp z,messg
        ld a,(mpsize)   ; has the memory mapper at least 128k?
        cp 7
        jp c,messg
analyz: ld a,'w'        ; /W present? load over the network via MSXPi
        call srchco2    ; instead of from disk - NOT /P: that's already
        jr nz,analyz0   ; "/Pn - load patchfile <n>" (see patchf's own
                        ; command-line scan and the help text), and
                        ; srchco2 is a substring match, so /P would also
                        ; incorrectly match here. This check is at analyz:
                        ; itself (not further up, e.g. near the /G check)
                        ; because analyz: is the one point every path that
                        ; needs to load a cartridge actually converges on,
                        ; regardless of whether /G/​/G1/​/G2 was also given -
                        ; anywhere earlier risks being skipped by one of
                        ; those paths' own jr/jp
        ld a,1
        ld (usepi),a
        jp pinet
analyz0:call dskchg
        ld de,msg5      ; display analyzing message
        call messg
        call printfn    ; print file name and ':'
        ;ld de,fcb       
        call openrom
        or a            ; ok?
        jp nz,error     ; if no, error
        ld de,msg8      ; print type message
        call messg
        ld hl,romsize   ; set HL to file size 
        ld de,type1     ; set DE to size table
size1:  push hl
        push de
        ld b,4          ; compare size and size table
size2:  ld a,(de)
        cp 255          ; end of table?
        jp z,errort     ; if yes, error
        cp (hl)         ; compare
        jr nz,size3     ; if not equal, next type
        inc de
        inc hl
        djnz size2      ; next byte
        jr size4        ; go to load file
size3:  pop hl  
        ld de,21
        add hl,de       ; add 21 to DE (next table entry)
        push hl         
        pop de
        pop hl          
        jr size1        ; compare next entry
size4:  pop bc          ; clear stack
        pop bc
        ld a,(de)       ; get file type
        inc de
        push af         
        ld a,(de)       ; get file size in 8k blocks
        ld (sizeb),a
        inc de
        ld a,(de)       ; get percentage increment
        ld (perc),a
        inc de
        call messg      ; print file type
        pop af
        ld (type),a     ; save file type
        cp 2            ; is MegaROM?
        jr c,size40
        jr size41       ; if yes, go to size41
size40: ld a,(gmload)   ; if is 16/32k and GameMaster is loaded,
        or a
        jr z,test
        ld a,(mrslt)    ; and there is no MegaRAM on system,
        cp 255
        jr nz,test
        ld de,msg15
        jp endwmsg      ; error!
size41: ld a,(mrslt)    ; is MegaROM and there is a MegaRAM on system?
        cp 255
        jr z,size6      ; if not, error
        ld a,(type)     ; get file size
        ld b,a
        ld a,(megatyp)  ; and MegaRAM size
        cp b            ; if file size is greater than MegaRAM,
        jr c,size5      ; error (message 28)
        jr test         ; else continue
size5:  ld de,msg28     
        jp endwmsg
size6:  ld de,msg7      ; if there is no MegaRAM on system, warn user
        jp endwmsg      ; and terminate

;   *** Test if file is a true ROM and try guessing MegaROM type

test:   ld hl,fcb       ; set actual opened file for DOS1 BLKRD routine
        ld (openf),hl
        ld de,megabuf
        ld a,(fhandle)
        call testrom    ; test if file is a true ROM
        ld a,(type)
        cp 2            ; if file is MegaROM,
        jp c,ender
        ld de,msg48     ; try guessing type:
        call messg
        ld ix,megabuf   ; IX=ROM header to make checksum
        call cheksum    ; make ROM checksum
        ld ix,megatbl   ; IX=signature table
testr1: ld a,(ix)
        cp 255          ; end of table?
        jr z,testr3     ; go to TESTR3
        ld b,a          ; B=ROM mapper
        ld e,(ix+1)
        ld d,(ix+2)     ; DE=ROM signature
        xor a
        push hl
        sbc hl,de
        ld a,h
        or l            ; HL=DE?
        jr z,testr2     ; go to TESTR2
        ld de,3
        add ix,de       ; else next signature
testr11:ld a,(ix)
        inc ix
        cp 24h
        jr nz,testr11
        ld hl,guessn
        inc (hl)
        pop hl
        jr testr1
testr2: pop hl          ; ROM found in table:
testr21:ld a,b
        and 0Fh
        ld (guessr),a   ; save ROM mapper
        ld a,b
        and 00010000B
        ld (sccr),a     ; save SCC game flag
        ld de,3
        add ix,de
        push ix
        pop de          ; DE=ROM name
        call messg      ; print ROM name
        jp mega         ; go to MegaRAM loader routine
testr3: call checkon    ; check if game is Konami with SCC by RC number
        cp 255
        jr nz,testr21   ; also didn't found?
        ld de,msg58     ; ROM not found in table...
        call messg
        ld a,255
        ld (guessn),a
        jp mega         ; go to MegaRAM loader routine

;   *** Check if game is Konami with SCC by RC number

checkon:ld ix,konatab
checko1:ld hl,(megabuf+12h)
        ld a,(ix)
        cp 255
        ret z
        ld d,(ix+1)
        ld e,(ix+2)
        or a
        sbc hl,de
        jr z,checko2
        ld de,5
        add ix,de
        jr checko1
checko2:ld (guessn),a
        ld l,(ix+3)
        ld h,(ix+4)
        ld a,(hl)
        ld b,a
        push hl
        pop ix
        ret

;   *** Get ROM initial address, initialize variables and load 16k/32k ROM

ender:  ld hl,0         
        ld a,(type)     ; get cartridge type
        or a            ; is 16k?
        jr nz,ender1    
        call calc16     ; calculate its initial address
        jp nc,errorc    ; if confuse, error
        ld (rlcdes),hl  ; save initial address
        call chekbas    ; check if cartridge is BASIC ROM
        jr ender4       
ender1: call calc32     ; 32k: calculate its initial address
        ld (rlcdes),hl  ; save initial address
ender4: ex de,hl        
        ld a,d          ; verify initial address
        cp 40h
        jr c,ender5
        jr ender6       ; if is not 0000h, go to load
ender5: ld a,1          ; set relocation flag
        ld (rlcflg),a
        ld a,0f3h
        ld (reloc7),a   ; put DI before executing cartridge
        ld (rlcdes),de
        ld a,d
        ld de,(rlcini)  ; set temporary program address
ender6: ld b,a
        ld a,(gmload)   ; if Game Master is loaded
        or a
        jr z,load0
        ld a,b
        ld de,msg24     ; and 16/32k file begins at 4000h,
        cp 40h
        jp nz,messg     
        jp mega         ; load it on MegaRAM
load0:  ld a,(rommode)  ; if option /N not present,
        or a
        jr z,load       ; load ROM in RAM
        ld de,msg46     ; else warn user
        call messg
        jp mega         ; and load ROM in MegaRAM
load:   xor a
        ld (rommode),a  ; set flag of 16/32k loaded in RAM
        push de
        ld de,msg23     ; show loading message
        call messg
        pop hl          ; HL=initial address of ROM
        ld de,convr     ; DE=address to jump after load ROM
        ld a,(perc)     
        ld c,a          ; C=percentage increment
        ld a,(fhandle)
        ld b,a          ; B=file handle (if MSXDOS2)
        ld a,(sizeb)    ; A=number of 8k blocks to read
        jp loadrom

;   *** Set RAM and GameMaster, stop drive, convert game if /R# or /T#
;       option, patch game if /C or /F option, process options /B, /E,
;       /I, /N, /G2, /U and /P, execute cartridge

convr:  call closef
        call set800     ; switch to R800 mode if TR
        call romtype    ; Verify option /R and modify ROM if necessary
        call convtyp    ; Verify option /T and modify ROM if necessary
        ld a,'i'        ; if option /I present, skip autoload patchfile
        call srchco2
        call nz,autoxpc
verif:  ld hl,80h       ; test for '/' character in command line
verif1: inc hl
        ld a,(hl)
        cp '/'
        call z,path1    ; if found, verify if is a /C, /B or /F command
        or a
        jr nz,verif1    
patchp: ld a,(basrom)
        or a
        jr nz,patchp1
        ld a,'u'
        call srchco2
        call nz,sccptch ; Enable SCC if option /U not present
patchp1:call patchf     ; Patch ROM if option /P present
        call enhanc     ; Change palette if option /E not present (but not for BASIC cartridges)
        call set800     ; switch to R800 mode if TR
        ld a,'z'
        call srchco2    ; if option /Z present, doesn't set TR to Z80 mode
        call nz,setz80
        ld a,(gmtype)   ; if option /G2 present, go load GameMaster2
        cp 2
        jp z,setgm2
        call stpdrv
execut: ld a,'x'
        call srchco2    ; option /X present?
        jr nz,execut1   ; if yes,
        call setram     ; set cartridge in MegaRAM
        call setorig    ; set original slot configuration
        ld de,msg47     ; inform finished loading and
        call messg      ; terminate program
        call crlf
        jp endprg       ; else
execut1:ld de,msg6      ; print execution message
        call messg
        call setmapp    ; set different MegaRAM initial mapping if necessary
        call setram     ; set MegaRAM and RAM configuration for execution
sign:   ld a,'s'        ; if /S present, don't clear cartridge signature
        call srchco2
        jr z,gmset1
        ld a,(gmload)   ; ignore /S if Game Master I loaded
        or a
        jr nz,gmset1
        in a,(8eh)
        ld hl,(rlcini)
        ld (hl),0
        inc hl
        ld (hl),0
        out (8eh),a
gmset1: ld a,(gmload)   ; verify if Game Master is loaded
        or a
        jr z,gmset2     ; if yes,
        call setorig    ; select Game Master page
        ld hl,4000h
        ld (rlcdes),hl
gmset2: call clearm     ; if option /M present, clear MSXDOS and hooks
execf:  ld bc,relocf-reloc+1
        ld hl,reloc
        ld de,rlcadd
        ldir            ; move relocable routine
        ld a,(basrom)
        or a
        jp nz,gobasic   ; if ROM is BASIC, go execute it
        call setbdhk    ; clear BDOS hooks pointing to MSXDOS kernel
        out (08eh),a    ; confirm MegaRAM is in ROM mode
        call setscc     ; set SCC page if SCC using it
        jp rlcadd       ; execute relocation/execution routine

; ** Set different MegaRAM initial mapping if necessary

setmapp:ld a,(guessn)
        cp 73           ; R-Type original ROM starts with megarom controller on pages 1E/1F/1E/1F
        jr nz,setmap1
        ld a,1eh        
        ld (mrpages),a
        ld (mrpages+2),a
        inc a
        ld (mrpages+1),a
        ld (mrpages+3),a
        ret
setmap1:cp 81            ; Gall Force original ROM starts with megarom controller on pages 0/1/0/0
        jr nz,setmapz
        ld hl,0100h
        ld (mrpages+2),hl
        ret
setmapz:ret

; *** Check if 16KB cartridge is ROM

chekbas:ld hl,(rlcdes)
        ld a,h
        or l
        ret nz          ; must have initial address 0000h
        ld a,(megabuf+9)
        or a
        jp z,errorc     ; must have TEXT attribute set
        and 11110000B
        cp 80h
        jp c,errorc     ; TEXT must be greater than 7FFFh
        cp 0B0h
        jp nc,errorc    ; TEXT must be less than C000h
        ld hl,8000h
        ld (rlcdes),hl  ; initial address: 8000h
        ld a,1
        ld (basrom),a   ; set BASIC ROM flag
        ret

;   *** Set RAM/MegaRAM configuration for running cartrdige

setram: ld a,(type)
        cp 2            
        jr c,setram0    
        jr setram2
setram0:ld a,(gmload)
        or a
        jr nz,setram1   ; if GameMaster loaded, select ROM in MegaRAM
        ld a,(rommode)
        or a
        ret z
        ld a,(rlcdes+1) ; if is 16/32k and begins at 4000h, select it
        ld de,msg45
        cp 40h
        jr z,setram1
        cp 80h          ; if is 16k and begins at 8000h, select it
        jp nz,messg     ; else display error if ROM begins at 0000h
        ld hl,mrpages
        jr setramb
setram1:ld a,(mrslt)    ; for 16/32k games with GameMaster,
        ld hl,4000h     ; select game on MegaRAM slot
        call 0024h
        out (08eh),a
        ld a,(mrpages)
        ld (4000h),a
        ld a,(mrpages+1)
        ld (6000h),a    ; (select 16k at 4000h, MegaRAM banks)
        ld a,(type)
        or a
        ret z           ; if game is 32k, select 16k at 8000h (MegaRAM banks)
        ld hl,mrpages+2
setramb:push hl
        ld a,(mrslt)
        ld hl,8000h
        call 0024h
        out (08eh),a
        pop hl
        ld a,(hl)
        ld (8000h),a
        inc hl
        ld a,(hl)
        ld (0A000h),a
        ret
setram2:ld a,(mrslt)    ; for MegaROM games, select pages 0,1,2,3 at
        ld hl,8000h     ; MegaRAM slot, page 1,2 (4000h-BFFFh)
        call 0024h      ; but enable MegaRAM only at page 1
        out (08eh),a
        ld a,(mrpages+2)
        ld (8000h),a
        ld a,(mrpages+3)
        ld (0A000h),a
        call setorig
        ld a,(mrslt)
        ld hl,4000h
        call 0024h
        out (08eh),a
        ld a,(mrpages)
        ld (4000h),a
        ld a,(mrpages+1)
        ld (6000h),a
        ret

;   *** Load GameMaster2 and run cartridge

setgm2: ld a,'2'
        ld (gmver),a
        ld (gmfcbv),a
        ld de,msg47
        call messg
        ld de,msg33     ; print GameMaster2 load message
        call messg
        call opengm
        or a
        jp nz,error
        ld hl,(gmsize)
        ld a,h
        or l
        jr nz,setgm21
        ld a,(gmsize+2)
        cp 2            ; is 128k cartridge?
        jr z,setgm22    ; if yes, go to setgm22
setgm21:ld de,msg10     ; else print error
        jp endwmsg
setgm22:ld de,megabuf
        ld a,(thandle)
        call testrom    ; test if true ROM
        ld ix,megabuf
        call cheksum
        ld de,8d28h
        sbc hl,de       ; cartridge is really Game Master II?
        ld a,h
        or l
        jp nz,errorf    ; if not, error!
        call setram     ; set cartridge for execution
        call setorig    ; restore RAM
        ld a,1
        out (0feh),a    ; mapper page 1 at RAM page 2
        ld hl,gmaster
        ld de,gm2fcb
        ld bc,38
        ldir            ; move GM2 FCB
        ld a,(thandle)
        ld (gm2hand),a  ; save handle
        ld a,(dosver)
        ld (gm2dosv),a  ; save DOS version
        ld a,'m'
        call setgm24
        ld (gm2clrm),a  ; save /M option
        ld a,'z'
        call setgm24
        ld (gm2z80),a   ; save /Z option
        ld hl,gm2cnv
        ld de,gm2cnvt
        ld bc,gm2cnvf-gm2cnv+1
        ldir            ; move conversion table
        ld a,(mpsize)
        ld (gm2mapp),a  ; save mapper size for loader
        cp 9            ; more than 128k of mapper?
        jr c,setgm23
        ld hl,gm2mmmm   ; so put disk var recovering routine in memory
        ld de,gm2bbbb
        ld bc,gm2mmm1-gm2mmmm
        ldir
        ld hl,gm2dcnv   ; and put GM2 disk patch table in memory
        ld de,gm2cnvt+gm2cnvf-gm2cnv
        ld bc,gm2dcnf-gm2dcnv+1
        ldir
        ld a,(0ffa7h)   ; and disable GM2 disk disabling (see gm2hexc)
        ld (gm2hex1+1),a
setgm23:ld hl,gm2load
        ld de,gm2subr
        push de         ; put loader address in stack
        ld bc,gm2loaf-gm2load+1
        ldir            ; move loader
        ld hl,gm2hexc
        ld de,rlcadd
        ld bc,gm2hexf-gm2hexc
        ldir            ; move execution code
        ld hl,0
        ld a,(0fcc1h)
        jp 0024h        ; enable ROM and return directly to loader
setgm24:call srchco2    ; if option in A exists, return A=1 else A=0
        jr z,setgm25
        ld a,0
        ret
setgm25:ld a,1
        ret
        ;
gm2mmmm:pop hl          ; BDOS var area recoverer for GM2
        ld (gm2bbbb-2),hl
        ld a,1
        out (0fdh),a    ; load BDOS var area
        ld hl,06500h
        ld de,0e280h
        ld bc,01100h
        ldir
        ld a,2
        out (0fdh),a
        ld hl,(gm2bbbb-2)
        jp (hl)
gm2mmm1:
        ;
gm2hexc:ld sp,0f086h    ; GM2 startup
        ld a,1
        out (0fdh),a
        ld hl,0e280h    ; save BDOS var area
        ld de,06500h
        ld bc,01100h
        ldir
        ld a,2
        out (0fdh),a
        ld a,3
        out (0feh),a
gm2hex1:db 03eh,0c9h    ; LD A,0C9H
        ld (0ffa7h),a   ; disable disk for GM2 or not
        jp 5583h
gm2hexf:
                        ; GM2 loader
gm2load:ld hl,4         ; offset of ROM to load in 2000h blocks
        ld de,8000h     ; address to load block to
        ld bc,1         ; number of 2000h blocks do load
        call readgm2+gm2bias
        ld hl,'41'      ; 2-digits percentage
        call prtperc+gm2bias
        ld a,2
        out (0fdh),a
        ld hl,0
        ld bc,2
        ld de,4000h
        call readgm2+gm2bias
        ld hl,'82'
        call prtperc+gm2bias
        ld a,3
        out (0fdh),a
        ld de,4000h
        ld hl,2
        ld bc,2
        call readgm2+gm2bias
        ld hl,'24'
        call prtperc+gm2bias
        ld a,4
        out (0fdh),a
        ld de,4000h
        ld hl,5
        ld bc,2
        call readgm2+gm2bias
        ld hl,'65'
        call prtperc+gm2bias
        ld a,5
        out (0fdh),a
        ld de,4000h
        ld hl,7
        ld bc,2
        call readgm2+gm2bias
        ld hl,'07'
        call prtperc+gm2bias
        ld a,6
        out (0fdh),a
        ld de,4000h
        ld hl,9
        ld bc,2
        call readgm2+gm2bias
        ld hl,'48'
        call prtperc+gm2bias
        ld a,7
        out (0fdh),a
        ld de,4000h
        ld hl,9
        ld bc,1
        call readgm2+gm2bias
        ld de,6000h
        ld bc,1
        ld hl,11
        call readgm2+gm2bias
        ld de,gm2100p+gm2bias
        call gm2prts+gm2bias
        ld a,(gm2dosv)  
        cp 2            ; if DOS2, close file
        jr nz,gm2stp
        ld a,(gm2hand)
        ld b,a
        ld c,45h
        call 0f37dh
gm2stp: ld de,gm2stpd+gm2bias
        call gm2prts+gm2bias
        di              ; disable interrupts
        ld b,255        ; loop size
gm2stp1:push bc
        call 0fd9fh
        pop bc
        djnz gm2stp1    ; repeat loop
        ld de,gm2dmsg+gm2bias
        call gm2prts+gm2bias
        ld de,gm2ddis+gm2bias
        ld a,(gm2mapp)  ; print if disk is enabled or not in GM2
        cp 9
        jr c,gm2stp2
        ld de,gm2dena+gm2bias
gm2stp2:call gm2prts+gm2bias
        ld ix,gm2cnvt   ; patch GM2 for mapper
patgm20:ld a,(ix)
        cp 255          ; end of patch table?
        jr z,gm2fin
        out (0fdh),a    ; page...
        inc ix
        ld a,(ix)
        inc ix
        ld b,a          ; number of patches in this page...
patgm21:push bc
        ld e,(ix)
        inc ix
        ld d,(ix)       ; DE=relative address...
        inc ix
        ld a,(ix)
        ld b,a          ; number of bytes to change
        inc ix
        ld hl,4000h
        add hl,de       ; HL=absolute address...
patgm22:ld a,(ix)
        inc ix
        ld (hl),a       ; patch code..
        inc hl
        djnz patgm22    ; next byte
        pop bc
        djnz patgm21    ; next patch in this page
        jr patgm20      ; next page
gm2fin: ld de,gm2exec+gm2bias
        call gm2prts+gm2bias
        ld a,(gm2z80)   ; option /Z
        or a
        jr nz,gm2fin1
        ld a,(2dh)
        cp 3
        jr nz,gm2fin1
        ld a,11001110b  ; Z80 mode
        and 02h
        xor 82h
        ld iy,0
        ld ix,0180h
        call 001ch
gm2fin1:ld a,(gm2clrm)  ; option /M
        or a
        jr z,gm2fin2
        ld hl,0db00h
        ld de,0db01h
        ld bc,014ffh
        ld (hl),0
        ldir            ; clear DOS memory area
        ld hl,0fd9ah
        ld de,0fd9bh
        ld bc,0022fh
        ld (hl),0c9h
        ldir            ; restore all hooks
gm2fin2:ld a,0c9h       ; clear BDOS hooks pointing to MSXDOS kernel
        ld (0f368h),a
        ld (0f36bh),a
        ld (0f36eh),a
        jp rlcadd
prtperc:ld (gm2pstr+gm2bias+3),hl
        ld de,gm2pstr+gm2bias
gm2prts:ld c,9
        jp 0f37dh
readgm2:ld a,(gm2dosv)  ; read GM2: HL=offset, DE=destination, BC=size
        cp 2
        jr z,redgm22    ; in DOS1:
        ld (gm2fcb+33),hl
        ld hl,0         ; offset
        ld (gm2fcb+35),hl
        ld hl,2000h
        ld (gm2fcb+14),hl
        push bc         ; size
        ld c,1ah
        call 0f37dh     ; DTA
        pop hl
        ld c,27h        ; read
        ld de,gm2fcb
        call 0f37dh
        or a
        jr nz,redgm23   ; error?
        ret
redgm22:push bc         ; in DOS2:
        push de
        add hl,hl       ; HL=HL*2
        ld a,l
        and 11110000b   ; DE:HL=HL*01000h
        srl a
        srl a
        srl a
        srl a
        ld e,a
        ld d,0
        ld a,l
        sla a
        sla a
        sla a
        sla a
        ld h,a
        ld l,0          ; DE:HL=offset in bytes
        ld a,(gm2hand)
        ld b,a
        ld a,0
        ld c,4ah        ; offset
        call 0f37dh
        or a
        jr nz,redgm23
        pop de
        pop hl
        add hl,hl       ; HL=BC*2
        ld a,l
        sla a
        sla a
        sla a
        sla a
        ld h,a          ; HL=HL*01000h
        ld l,0          ; HL=size in bytes
        ld a,(gm2hand)
        ld b,a
        ld c,48h
        call 0f37dh     ; read
        or a
        ret z
redgm23:ld de,gm2erio+gm2bias
        ld c,9
        call 0f37dh
        ld iy,(0f340h)  ; slot of page 0 of RAM
        ld ix,0
        jp 001ch        ; reboot DOS
gm2pstr:db 8,8,8,'  %$',0
gm2100p:db 8,8,8,8,'100%$'
gm2exec:db 13,10,'- Executing ROM cartridge$'
gm2erio:db 13,10,'Error reading file',13,10,'$'
gm2stpd:db 13,10,'- Stopping the drive$'
gm2dmsg:db 13,10,'- Game Master II disk usage $'
gm2ddis:db 'disabled$'
gm2dena:db 'enabled$'
gm2loaf:

;   *** Autoload patchfile

autoxpc:ld a,(dosver)
        cp 2
        jr z,autoxp2
        ld a,'X'        ; autoload patchfile: set ROM file extension to XPC
        ld (ext),a
        ld hl,'CP'
        ld (ext+1),hl
        ld hl,fcbfoo
        ld de,fcbfoo+1
        ld bc,24
        ld (hl),0       ;                     clear FCB
        ldir
        ld de,fcb
        ld c,0fh
        call 5          ;                     try opening patchfile
        or a
        ret nz          ;                     if success,
autoxp1:ld de,msg32     ;                     print message 'Opening file' 
        call messg      
        call printfn    ;                     and filename
        push bc         ;                     [these PUSH/POP are for compa
        call patch21    ;                      tibility with error routine in
        pop bc          ;                      patchfile routine]
        ret             ;                     process patchfile
autoxp2:ld hl,(romext)
        ld (hl),'X'     ; substitute extension to XPC
        inc hl
        ld (hl),'P'
        inc hl
        ld (hl),'C'
        inc hl
        ld (hl),0
        ld de,(fnamadr)
        ld a,0000001b   ; read-only mode
        ld c,43h
        call 5
        or a
        ret nz
        ld a,b
        ld (thandle),a
        ld a,'X'        ; set ROM file extension to XPC in FCB (for PRINTFN)
        ld (ext),a
        ld hl,'CP'
        ld (ext+1),hl
        jr autoxp1

;   *** Options /C (patch), /F (fill), and /B (boot)

path1:  inc hl          ; get option
        ld a,(hl)
        and 223         ; convert to uppercase
        cp 'C'          ; if is 'C'
        call z,path2    ; go to path2
        cp 'F'          ; if is 'F'
        call z,path3    ; go to path3
        dec hl          
        ld a,(hl)       ; don't return A=0 for not false 'end of line'
        ret             ; return
path2:  push af         ; save used registers
        push de
        push hl
        inc hl          
        xor a           ; initialize page to be patched
        ld (pathpg),a
        ld a,(type)     ; if ROM is not MegaRAM,
        cp 2            ; don't ask page
        jr c,path20
        call read2      ; else get page to be patched
        jp c,path21     ; error?
        ld (pathpg),a   ; save page
        call testspc    ; test for ',' separator
        jp c,path21
path20: call read4      ; get relative address to be patched
        jp c,path21     ; error?
        ld (pathad),bc  ; save relative address to be patched
        call testspc    ; test for ',' separator
        jp c,path21
        call read2      ; read byte to put on address
        jp c,path21     ; error?
        push af         ; save page
        ld a,(pathpg)   ; select right page
        call chgpage
        in a,(08eh)     ; prepare MegaRAM for writing (if MegaROM cartridge)
        ld hl,(pathad)  ; get relative address
        pop af
        ld de,(rlcini)  ; convert to absolute address
        add hl,de
        ld (hl),a       ; patch byte
        push hl
        ld de,msg26     ; inform patch
        call messg
        pop hl          ; restore registers
path21: pop hl
        pop de
        pop af
        ret             ; return
path3:  push af         ; save used registers
        push de
        push hl
        inc hl
        xor a           ; initialize pages to be filled
        ld (pathpg),a
        ld (pathpg2),a
        ld a,(type)     ; if ROM is not MegaRAM,
        cp 2            ; don't ask page
        jr c,path30
        call read2      ; else get initial page to be filled
        jp c,path34     ; error?
        ld (pathpg),a   ; save initial page
        call testspc    ; test for ',' separator
        jp c,path34     
        call read2      ; get final page to be filled
        jp c,path34     ; error?
        ld (pathpg2),a  ; save final page
        call testspc    ; test for ',' separator
        jp c,path34
path30: call read4      ; get initial relative address to be patched
        jp c,path34     ; error?
        ld (pathad),bc  ; save initial relative address
        call testspc    ; test for ',' separator
        jp c,path34
        call read4      ; get final relative address to be patched
        jp c,path34     ; error?
        ld (pathad2),bc ; save final relative address
        call testspc    ; test for ',' separator                               
        jp c,path34
        call read2      ; get byte to fill with
        jp c,path34     ; error?
        ld c,a          ; save fill byte
        ld de,msg27     ; inform patch
        call messg
        ld de,(rlcini)  ; convert relative addresses to absolute addresses
        ld hl,(pathad)
        add hl,de
        ld (pathad),hl
        ld hl,(pathad2)
        add hl,de
        ld (pathad2),hl
        ld a,(pathpg)   ; get initial page
        ld b,a
        ld a,(pathpg2)  ; and final page
        cp b            ; if they are the same,
        jr nz,path34
        call chgpage    ; select the page
        in a,(08eh)     ; prepare MegaRAM for writing (if MegaROM cartridge)
        ld hl,(pathad)  
        ld de,(pathad2)
        call fillram    ; fill it
        jr path34       ; and return
path31: ld a,b          ; else 
        call chgpage    ; select first page
        in a,(08eh)     ; prepare MegaRAM for writing (if MegaROM cartridge)
        ld hl,(pathad)   
        ld de,7fffh
        call fillram    ; fill first page from address to end
        ld a,(pathpg2)  ; verify if final page
        dec a           ; is the next
        cp b            ;
        jr z,path33     ; if yes, jump to path33
        ld b,a          ; if not,
        ld a,(pathpg)
path32: inc a           ; select intermediary pages
        call chgpage    ; select page
        in a,(08eh)     ; prepare MegaRAM for writing (if MegaROM cartridge)
        ld hl,4000h     
        ld de,7fffh
        call fillram    ; and fill them all
        cp b             
        jr nz,path32    ; until before last page
path33: inc a             
        call chgpage    ; select last page
        in a,(08eh)     ; prepare MegaRAM for writing (if MegaROM cartridge)
        ld hl,4000h     ; fill last page
        ld de,(pathad2) 
        call fillram    ; from begining to address
path34: pop hl          ; restore registers
        pop de
        pop af
        ret             ; return

;   *** Make MegaROM program think MSX is japanese, international, MSX1,
;       MSX2, MSX2+ or MSX Turbo-R
;       Warning: all registers and flags are affected

convtyp:ld a,(type)     ; if not MegaROM, ignore /T option
        cp 2
        ret c
        ld a,'t'        ; test for /T option
        call srchco2
        ret nz
        ld a,(hl)
        call upperc     ; get type and go to correspondent routine
        cp 'I'          
        jr z,convty1
        cp 'J'
        jr z,convty2
        cp '1'
        jr z,convty3
        cp '2'
        jr z,convty4
        cp '+'
        jr z,convty5
        cp 'T'
        jr z,convty6
        ld de,msg41     ; if type is not I,J,1,2+ or T, display error
        jp endwmsg
convty1:ld a,1          ; International MSX: set type, ROM address and message
        ld hl,msg50     ;                    and go to convty7
        ld b,2Bh
        jr convty7
convty2:ld a,0          ; Japanese MSX: set type, ROM address and message
        ld hl,msg49     ;               and go to convty7
        ld b,2Bh
        jr convty7
convty3:ld a,0          ; MSX1: set type, ROM address and message
        ld hl,msg53     ;       and go to convty7
        ld b,2Dh
        jr convty7
convty4:ld a,1          ; MSX2: set type, ROM address and message
        ld hl,msg54     ;       and go to convty7
        ld b,2Dh
        jr convty7
convty5:ld a,2          ; MSX2+: set type, ROM address and message
        ld hl,msg55     ;       and go to convty7
        ld b,2Dh
        jr convty7
convty6:ld a,3          ; MSX TR: set type, ROM address and message
        ld hl,msg56     ;         and go to convty7
        ld b,2Dh
convty7:ld (convtyA+1),a
        ld a,b
        ld (convty9+1),a
        ld de,msg35
        call messg
        ex de,hl
        call messg
        ld hl,convty8   ; set conversion routine (convty8)
        ld (convro3+1),hl
        ld d,3Ah
        jp convrom
convty8:dec bc          ; ** Conversion routine
        dec bc
        inc hl          ; if the 2 bytes after 3Ah are 2Bh/2Dh and 00h,
        ld a,(hl)
        inc hl
convty9:cp 0
        ret nz
        ld a,(hl)
        or a
        ret nz          
        dec hl          ; change the three bytes to 3Eh XX 00h
        dec hl          ; where XX was set by option /Tx
        ld (hl),3Eh
        inc hl
convtyA:ld (hl),0
        inc hl
        ret

;   *** Convert ROM file from any MegaROM type to work on MegaRAM
;       Warning: all registers and flags are affected

romtype:ld a,(type)     ; if not MegaROM file, ignore /R
        cp 2
        ret c
        ld a,(guessr)   ; if MegaROM was guessed,
        cp 255
        jr z,romtypr    ; get ROM type
        ld a,(guessr)
        add a,30h
        jr romtyp0      ; and start converting
romtypr:ld a,'r'        ; else
        call srchco2
        ret nz          ; if /R not requested, return
        ld a,(hl)
romtyp0:ld hl,emul16k   ; install resident code for emulating 16k block ROMs
        ld de,em16kadd
        ld bc,emul16f-emul16k+1
        ldir
        ld de,msg34
        call messg
        sub 30h         
        cp 0            ; if ROM type is
        ret z           ; 0, return
        cp 1
        jr z,romtyp1    ; 1, go to romtyp1
        cp 2
        ret z           ; 2, return
        cp 3
        ret z           ; 3, return
        cp 4
        jp z,romtyp4    ; 4, go to romtyp4
        cp 5
        jp z,romtyp5    ; 5, go to romtyp5
        pop de
        ld de,msg20     
        jp endwmsg      ; else error
romtyp1:ld hl,romty10
romtyi0:ld (convro3+1),hl
        ld d,32h
        jp convrom
romty10:dec bc          ; ** Conversion routine for MegaROM type 01
        dec bc
        inc hl          
        inc hl
        ld a,(hl)       ; if address is not between 4000h and BFFFH, return
        cp 40h
        ret c
        cp 0BFh
        ret nc
        ld ix,em16kadd  ; if address is between 4000h and 7FFFh, is bank 1
        cp 80h
        jr c,romty11    ; else is bank 2
        ld ix,em16kadd+embank2-embank1
romty11:dec hl
        dec hl
        ld (hl),0CDh    ; change 32h XX YY do CD AA BB,
        inc hl          
romty13:ld (romty14+2),hl
        inc hl          ; where AA BB is the address pointed by IX
romty14:ld (0000),ix    ; (embank1 or embank2)
        ret
romtyp4:ld hl,romty40
        jp romtyi0
romty40:dec bc          ; ** Conversion routine for MegaROM type 04
        dec bc
        inc hl          
        inc hl          
        ld a,(hl)       ; if the next second byte is minor than 60h
        cp 60h          ; (6000h) or greater than 7Fh (7FFFh), return
        ret c
        cp 7Fh
        ret nc
        dec hl
        ld ix,4000h     
        cp 68h          ; if address is between 6000h and 67FFh, is bank 1,
        jr c,romty13    ; change the bank address to the correct on MegaRAM
        ld ix,6000h
        cp 70h          ; if address is between 6800h and 6FFFh, is bank 2,
        jr c,romty13    ; change the bank address to the correct on MegaRAM
        ld ix,8000h
        cp 78h          ; if address is between 7000h and 77FFh, is bank 3,
        jr c,romty13    ; change the bank address to the correct on MegaRAM
        ld ix,0A000h    ; else address is between 7800h and 7FFFh (bank 4),
        jr romty13      ; change the bank address to the correct on MegaRAM
romtyp5:ld hl,romty50
        jp romtyi0
romty50:dec bc          ; ** Conversion routine for MegaROM type 05
        dec bc
        inc hl          
        inc hl          
        ld a,(hl)       ; if the next second byte is minor than 60h
        cp 60h          ; (6000h) or greater than 7Fh (7FFFh), return
        ret c
        cp 7Fh
        ret nc
        ld ix,em16kadd  ; if address is between 6000h and 6FFFh,
        cp 70h          ; set jump to embank1
        jp c,romty11    ; else address is between 7000h and 7FFFh,
        ld ix,em16kadd+embank2-embank1
        jp romty11      ; set jump to embank2
        ret

;   *** 16k bank MegaROM emulation routine

emul16k:
embank1:push af
        rlca            ; convert 16k notation to 8k
        ld (4000h),a    ; enable 16k bank on page 1
        inc a
        ld (6000h),a
        pop af
        ret             ; total bytes: 11
embank2:push af
        rlca            ; convert 16k notation to 8k
        ld (8000h),a    ; enable 16k bank on page 2
        inc a
        ld (0a000h),a
        pop af
        ret             ; total bytes: 11
emul16f:

;   *** Search for byte on register D on MegaROM and call a routine if found
;       Warnings: all registers and flags are affected
;                 the total number of bytes to be modified must be three
;                 the routine can't modify BC,DE or HL
;                 the routine must decrease BC twice and increase HL twice

convrom:ld a,(sizeb)    ; get number of blocks
        dec a           ; minus 1 because we map 2 blocks at a time
        ld b,a
        xor a           ; initial page: 0
convro1:call chgpage    ; select actual page
        push af
        push bc
        in a,(08eh)     ; select MegaRAM for writing
        ld bc,3ffdh     ; search on page
        ld hl,4000h
convro2:ld a,(hl)           
        cp d            ; for first ocorrence
convro3:call z,0000     ; and call a routine if found
        inc hl
        dec bc          ; else continue until
        ld a,b
        or c
        jr z,convro4    ; end of page (BC=0)
        ld a,b
        and 10000000b
        or a            
        jr z,convro2    ; (BC<0)
convro4:pop bc
        pop af
        inc a           ; next page
        cp b            
        jr nz,convro1    
        ret             ; if end, return

;   *** Patchfile loading/application routine

patchf: ld hl,80h       ; search command line for /P option
patch1: inc hl
        ld a,(hl)
patch2: or a
        ret z
        cp '/'
        jr nz,patch1
        inc hl
        ld a,(hl)
        and 223
        cp 'P'
        jr nz,patch2
        push hl
        inc hl
        call patchf0    ; if found, go to patchf0
        pop hl
        jr patch1
patchf0:push hl         ; HL=patchfile name
        ld de,msg32
        call messg      ; print message 'Opening file' and filename
        pop hl
        call openxpc    ; open patchfile and print its name
        or a
        jp nz,patchf6   ; open file; if error, go to patchf6
patch21:ld hl,fcb
        ld (openf),hl
        ld hl,megabuf
        ld a,(thandle)
        call blkrd      ; read 8k block at megabuf
        cp 2            
        jp z,patchf6    ; go to patchf6 if error
        call closet
        ld hl,megabuf   ; if file hasn't signature,
        ld de,patchsg
        ld b,18
patchf3:ld c,(hl)
        ld a,(de)
        cp c
        jp nz,patchf7   ; go to patchf7
        inc hl
        inc de
        djnz patchf3
        ld de,msg36
        call messg      ; print patch version
        ld a,(hl)
        push hl         ; save HL (points do patchfile version)
        and 11110000b
        srl a
        srl a
        srl a
        srl a
        call prtnum
        ld e,'.'
        call prtchr
        pop hl
        push hl         ; repoint HL to patchfile version
        ld a,(hl)
        and 00001111b
        call prtnum     
        ld de,msg37     ; print patching message
        call messg
        pop hl          ; restore HL (points to patchfile version)
        inc hl          ; now HL points to number of patch blocks
patchf4:ld a,(hl)       ; get number of patch blocks
        or a
        ret z           ; (00 is end of file)
        ld b,a          ; B=number of patch blocks
        inc hl
        ld a,(hl)
        cp 255          
        jr z,patch42
        push bc
        inc hl
        ld de,msg42     ; print identation
        call messg
        ex de,hl
        push de
        call messg      ; print patch definition string
        ld de,msg43
        call messg      ; print "(Y/N)?"
        call patchf8    ; wait for response
        pop hl          ; HL=start of patch definition
        pop bc          ; B =number of patch blocks
        cp 'Y'
        jr z,patch42    
        jr patch52      ; skip patch application
patch42:call patch51    ; skip patch definition
patch43:push bc         ; save number of patchs
        ld a,(hl)
        ld b,a          ; B=patch block size
        inc hl
        ld e,(hl)       ; get initial address of modification
        inc hl
        ld d,(hl)
        inc hl
        push hl
        ld hl,(rlcdes)  ; convert to true ROM address in memory
        add hl,de
        ex de,hl
        pop hl
        ld a,(hl)       ; change page
        call chgpage
        in a,(08eh)     ; set MegaRAM for RAM
        inc hl
patchf5:ld a,(hl)       ; modify bytes
        ld (de),a
        inc hl
        inc de
        djnz patchf5
        pop bc
        djnz patch43
        jr patchf4
patch51:ld a,(hl)       ; skip patch definition string
        inc hl
        cp '$'
        ret z
        jr patch51
patch52:call patch51
patch53:ld a,(hl)
        ld e,a
        inc hl
        inc hl
        inc hl
        inc hl
        ld d,0
        add hl,de
        djnz patch53
        jr patchf4
patchf6:pop de          ; pop last CALL (to read patchfile routine)
        pop de          ; pop HL (points to command line)
        pop de          ; pop first CALL (to patchfile routine)
        jp error
patchf7:pop de          ; pop last CALL (to read patchfile routine)
        pop de          ; pop HL (points to command line)
        pop de          ; pop first CALL (to patchfile routine)
        jp errorf
patchf8:ld a,(yespatc)  ; if /Y option not present
        or a
        jr nz,patch81
        ld c,1          ; wait for a key (Y or N) and return
        call 5
        and 223
        ret
patch81:ld e,'Y'        ; else return Y
        call prtchr
        ld a,'Y'
        ret

;   *** Set or not CoolColors

enhanc: ld a,'e'        ; option /E requested?
        call srchco2
        ret z           ; return if yes
        xor a
        ld hl,2dh
        call 000ch      ; machine is MSX1?
        or a
        ret z           ; return if yes
        ld de,msg44
        call messg      ; print message
        xor a
        ld hl,7
        call 000ch      ; get VDP I/O port
        ld c,a
        inc c
        xor a
        out (c),a
        ld a,144
        out (c),a       ; set VDP to receive new palette
        inc c
        ld b,16         ; set MSX1 colors:
        ld hl,enhnclr   ; HL=color table
enhanc1:ld a,(hl)
        sla a
        sla a
        sla a
        sla a
        ld d,a          ; D=rrrr0000
        inc hl
        ld a,(hl)
        ld e,a          ; E=0000gggg
        inc hl
        ld a,(hl)
        or d            ; A=rrrrbbbb
        out (c),a
        ld a,e
        out (c),a       ; set color
        inc hl
        djnz enhanc1    ; next color
        ret             ; return

;   *** Relocation/execution routine

reloc:  di              ; disable interruptions
        ld sp,0f086h    ; set new stack (the default for MSX cartridges)
        ld hl,(rlcdes)  
        ld a,(type)     ; if file is not MegaROM, go to reloc0
        cp 2
        jr c,reloc0
        jr reloc4
reloc0: ld a,(rlcflg)   
        or a            ; verify if program need relocation
        jr z,reloc3     ; if yes, relocate it
        ld bc,(romsize)
reloc1: ld hl,(rlcini)  ; relocation routine:
        ld de,(rlcdes)  ; destination address in DE
        push de         ; save initial address
        ldir            ; initial address in HL
        pop hl          ; get initial program address
        jr reloc3       ; execute
reloc3: ld a,h          ; program use page 0?
        cp 3fh          ; if not, enable BIOS on page 0
        jr c,reloc5
reloc4: in a,(0a8h)
        and 11111100b
        out (0a8h),a
reloc5: ld a,(resetflg) ; /B option requested?
        or a
        jr z,reloc6     ; if yes,
        in a,(0a8h)     ; enable BIOS on page 0
        and 11111100b
        out (0a8h),a    ; and
        rst 0h          ; reset MSX
reloc6: inc hl          ; get program execution address
        inc hl
        ld a,(hl)       ; put this value in HL
        inc hl
        ld h,(hl)
        ld l,a
reloc7: di
        jp (hl)         ; execute program
relocf: 

;   *** Game Master I load routine

loadgm: ld de,msg33     ; print Game Master load message
        call messg
        call opengm
        or a
        jp nz,error
        ld a,(gmsize+1)
        cp 64           ; is 16k cartridge?
        jr z,loadgm1    ; if yes, go to loadgm1
        ld de,msg10     ; else print error
        jp endwmsg
loadgm1:ld de,4000h
        ld a,(thandle)
        call testrom
        ld ix,4000h
        call cheksum
        ld de,3de4h
        sbc hl,de       ; cartridge is really Game Master I?
        ld a,h
        or l
        jp nz,errorf    ; if not, error!
        ld hl,4000h
        ld de,loadgm2
        ld c,49h
        ld a,(thandle)
        ld b,a          ; B=GameMaster1 file handle (if MSXDOS2)
        ld a,2
        jp loadrom
loadgm2:call closet
        ld hl,0
        ld (06856h),hl  ; patch GM1 for disk usage [not trash F3xx]
        ld (4035h),hl   ;                          [don't search for diskrom]
        ld (4037h),hl
        ld (4039h),hl
        ld (403bh),hl
        ld a,1          ; set Game Master load flag
        ld (gmload),a   
        ld (gmtype),a   ; set Game Master I load flag
        ld hl,0
        ld (4000h),hl   ; disable Game Master signature
        call crlf       ; jump line
        jp analyz       ; return

; *** pinet: load a ROM over the MSXPi network interface instead of disk
; (/W option), landing in the same mega:/mega1 MegaRAM loading loop used
; for disk loads - see usepi's own declaration for the full rationale.
;
; Sends the exact filename already parsed from the command line (into
; name/ext - the same FCB fields printfn prints) to the server's own
; "execrom" command (msxpi-server.py), which resolves it against whatever
; path was last set via "p cd <path>" and returns the mapper-aware ROM
; header protocol directly - the non-interactive counterpart to
; msxarchive's browse-and-select flow. One round trip: send
; "execrom <filename>", receive the 16-byte header (+ROM body for
; accepted MegaROM types).
;
; Supports MAPPER_KONAMI/ASCII8/ASCII16 (1/2/3) - anything that loads
; through mega:/mega1's MegaRAM loop, same as the disk path. MAPPER_PLAIN
; (0, a different, non-MegaROM load path entirely) and anything unrecognized
; are reported as unsupported rather than guessed at.
pinet:  ld de,pimsg1
        call messg

        ; build "execrom <filename>" into cmdbuf, trimming the space-
        ; padded 8.3 name/ext fields the same way prtnam does when
        ; printing them (skip spaces - they only ever appear as trailing
        ; padding in an FCB name/ext, never in the middle)
        ld hl,cmdexroh
        ld de,cmdbuf
        ld bc,8
        ldir
        ld hl,name
        ld b,8
pinamlp:ld a,(hl)
        cp ' '
        jr z,pinamsk
        ld (de),a
        inc de
pinamsk:inc hl
        djnz pinamlp
        ld a,'.'
        ld (de),a
        inc de
        ld hl,ext
        ld b,3
pinextlp:ld a,(hl)
        cp ' '
        jr z,pinextsk
        ld (de),a
        inc de
pinextsk:inc hl
        djnz pinextlp
        xor a
        ld (de),a

        ld de,cmdbuf
        call SendCommandToMSXPi
        jp c,pinet_err

        ; receive the 16-byte ROM header (or, if rejected, the header plus
        ; a short reason string) - always fits in one block
        ld bc,2000h
        call PerformHandshake
        xor a
        ld de,8000h
        ld bc,2000h
        call RECVDATA_ONEBLOCK
        jp c,pinet_err
        ld hl,8000h      ; RECVDATA_ONEBLOCK returns the actual received
        add hl,bc        ; length in bc - force a null terminator right
        ld (hl),0        ; after it, since a rejection reason string isn't
                        ; padded by the server the way the listing text is
                        ; (see pinet_rejected below), and whatever was left
                        ; over in this buffer from the earlier listing
                        ; receive isn't guaranteed to provide one nearby

        ld a,(8000h)     ; magic byte
        cp 52h           ; 'R'
        jp nz,pinet_err

        ld a,(8002h)     ; mapperType
        ld (mapptyp),a
        cp 0ffh          ; rejected? (reason string follows the header)
        jr z,pinet_rejected
        cp 1             ; MAPPER_KONAMI/ASCII8/ASCII16 (1/2/3) all load
        jr c,pinet_unsup ; through the same mega:/mega1 MegaRAM loop below -
        cp 4             ; the actual bank-switch handling difference between
        jr nc,pinet_unsup ; them is patched in afterward by romtype: (see
                          ; pinetguess's own comment), keyed off the ROM's
                          ; own content, not the wire mapper type. MAPPER_
                          ; PLAIN (0) is a different, non-MegaROM load path
                          ; entirely (ender:/load:, not mega:) - unsupported
                          ; here, same as anything unrecognized.

        ; sizeb = bankCount * (bankSizeKB/8) - MegaRAM's native granularity
        ; is 8k; Konami/ASCII8 use 8k banks (multiplier 1), ASCII16 uses 16k
        ; banks (multiplier 2) - see detect_mapper's own bank_size_kb values
        ; (msxpi-server.py). bankCount low byte only - no realistic ROM needs
        ; the high byte (even a 1MB ROM is just 64 banks of 16k).
        ld a,(8003h)     ; bankSizeKB
        cp 16
        ld a,(8004h)     ; bankCount low byte
        jr nz,pinetsz1   ; 8k banks: sizeb = bankCount as-is
        add a,a          ; 16k banks: sizeb = bankCount*2
pinetsz1:
        ld (sizeb),a
        ld a,2           ; generic MegaROM type value - see usepi's own
        ld (type),a      ; declaration for why the exact size-table value
                          ; doesn't matter here

        ; disk loads get perc (the per-page progress-counter increment) from
        ; a fixed table keyed to known cartridge sizes (type1..typeA) - see
        ; wrtperc's own call site in mega1. Network ROMs aren't limited to
        ; those fixed sizes, so compute perc = 100/sizeb directly instead
        ; (clamped to a minimum of 1). Doesn't need to be exact - the table
        ; itself is already only an approximation (type=9's own 512k case
        ; alternates 3/0 for an average of 1.5/page) - and mega1's loop
        ; always shows an explicit, unconditional 100% at completion
        ; regardless (see mega1's own "ld de,msg22" line). Without this,
        ; perc stayed at its power-up default of 0 and the counter looked
        ; frozen at 000% until that final forced 100%.
        ld a,(sizeb)
        ld b,a
        ld c,0
        ld a,100
pinetpc:cp b
        jr c,pinetpc1
        sub b
        inc c
        jr pinetpc
pinetpc1:ld a,c
        or a
        jr nz,pinetpc2
        ld a,1
pinetpc2:ld (perc),a

        xor a
        ld (piblkidx),a
        ld bc,2000h      ; the one handshake that covers the whole ROM-body
        call PerformHandshake ; transfer (see netrd's own comment)

        ; Fetch page 0 and run the signature guess now, before mega:'s own
        ; "Loading file : 000%" counter starts - wrtperc updates that counter
        ; in place (backspace + reprint, see wrtperc's own comment), which
        ; only works if nothing else prints in between. Doing the guess here,
        ; up front, mirrors the disk path's own timing exactly (test: runs
        ; and prints before mega: is ever entered) instead of colliding with
        ; the live counter mid-loop. mega1 knows to reuse page 0 from 8000h
        ; instead of re-fetching it (see mega1b's own comment).
        call netrd
        cp 2             ; error? (same check mega1c itself uses)
        jp z,pinet_err
        call pinetguess
        jp mega

pinet_rejected:
        ld de,pimsgrj
        call messg
        ld hl,8010h      ; reason string starts right after the 16-byte
        call PRINT       ; header
        jp error

pinet_unsup:
        ld de,pimsgus
        call messg

        ; execrom() (msxpi-server.py) has no concept of "unsupported mapper
        ; type" - that's purely a limitation of this ASCII16-only client -
        ; so it always sends the full ROM body right after the header,
        ; unconditionally. If we error out here without reading it, the
        ; server is left mid-send and the MSXPi channel goes out of sync for
        ; whatever disk I/O runs next (e.g. COMMAND.COM redrawing the
        ; prompt) - drain and discard the body so the connection is left
        ; clean before we give up.
        ld bc,2000h
        call PerformHandshake
        xor a
        ld (piblkidx),a
pinetud:ld a,(piblkidx)
        ld de,8000h
        ld bc,2000h
        call RECVDATA_ONEBLOCK
        jr c,pinetud2   ; comms error - nothing more we can do, and we're
                        ; erroring out regardless
        cp RC_SUCCESS   ; last block?
        jr z,pinetud2
        ld hl,piblkidx
        inc (hl)
        jr pinetud
pinetud2:
        jp error

pinet_err:
        ld de,pimsger
        call messg
        jp error

;   *** MegaRAM file load routine

mega:   ld de,msg23     ; show loading message
        call messg
        ld a,(usepi)    ; network load? if so, pinet: already set sizeb/type
        or a            ; from the ROM header and did the one handshake that
        jr nz,mega0b    ; covers the whole ROM-body transfer - no FCB to open
        ld a,(fhandle)
        ld b,a
        call inifile
mega0b: ld a,(sizeb)    ; get total number of 8k blocks to read
        ld b,a
        ld c,0          ; initialize percentage counter
        ld d,0          ; initialize page selector
mega1:  ld hl,8000h     ; reinitialize HL pointer to 8000h
        ld a,(usepi)    ; network load? read the block from MSXPi instead
        or a            ; of disk
        jr nz,mega1b
        ld a,(fhandle)
        call blkrd
        jr mega1c
mega1b: ld a,d          ; network load: page 0 was already fetched (and
        or a            ; guess-detected) by pinet: itself, before this
        jr z,mega1b2    ; loop/percentage counter started - see pinet:'s
        call netrd      ; own comment. Reuse what's already at 8000h for
        jr mega1c       ; page 0 instead of re-fetching it.
mega1b2:xor a           ; a=0 = success
mega1c: cp 2            ; error?
        jp z,mega3      ; go to mega3 if not ok
        push bc
        push de
        ld a,(mrslt)
        ld hl,4000h
        call 0024h      ; enable MegaRAM at page 1
        pop de
        push de
        ld a,d
mega2:  out (08eh),a
        ld (4000h),a    ; change MegaRAM page
        in a,(08eh)     ; prepare MegaRAM for writing
        ld hl,8000h
        ld de,4000h
        ld bc,2000h
        ldir
        pop de
        pop bc
        ld a,(type)
        cp 9            ; patch percentage increment for 512k MegaROMs counter
        call z,mega4
        ld a,(perc)     ; increase progress
        add a,c         
        daa             ; adjust counter
        ld c,a
        call wrtperc    ; show progress
        inc d           ; increase page selector
        ld a,d
        cp b            ; verify if load is terminated
        jr nz,mega1     ; repeat loop if not
        ld de,msg22     ; else show load complete
        call messg
        jp convr        ; and go to patch routine
mega3:  call setorig    ; restore default slot configuration
        pop de          ; clear stack
        jp error        ; go to error routine
mega4:  ld a,(perc)     ; path percentage increment for 512k MegaROMs counter
        xor 3           ; (the best increment is 1.5, but we haven't decimals
        ld (perc),a     ;  in machine code; so, increment swaps 3 and 0)
        ret

; netrd: read one 8k block from MSXPi (network) into 8000h, matching
; blkrd's own calling convention (see blkrd's own comment) so mega1 needs
; no other changes: A=2 on error, any other value on success. HL is not
; updated (unlike blkrd) because mega1 overwrites HL immediately after
; checking the return code anyway, so blkrd's own "update HL" behavior is
; never actually used by its caller.
;
; PerformHandshake for the whole ROM-body transfer is done once, by pinet:
; (network path) or here would need to be done once for a disk-equivalent -
; but since sendmultiblock (server side) covers an entire transfer with a
; single handshake and then streams blocks until done, doing the handshake
; here on every call would be wrong - it must happen exactly once before
; mega1's loop starts. netrd itself only calls RECVDATA_ONEBLOCK, advancing
; its own persistent block index (piblkidx) each call.
netrd:  push bc
        push de         ; save mega1's d (page counter)/e - RECVDATA_ONEBLOCK
                        ; needs de as ITS OWN destination pointer, clobbering
                        ; whatever was there (same reason blkrd itself saves
                        ; and restores de internally)
        ld a,(piblkidx)
        ld de,8000h     ; dest - blkrd always targets 8000h too
        ld bc,2000h     ; 8192 bytes - matches blkrd's fixed block size
        call RECVDATA_ONEBLOCK
        jr c,netrd_err
        ld hl,piblkidx
        inc (hl)
        pop de
        pop bc
        xor a           ; a=0 = success
        ret
netrd_err:
        pop de
        pop bc
        ld a,2
        ret

; pinetguess: disk loads get their MegaROM bank-switch-opcode conversion
; (see romtype's own "MegaROM to MegaRAM" comment) because test: (the disk
; loading path) runs a checksum against megatbl/konatab BEFORE jumping to
; mega: and sets guessr accordingly. The /W path skips test: entirely (its
; signature lookup goes through testrom, a disk-only read), so guessr was
; staying at its default 255 and romtype: silently did nothing - the game
; loaded into MegaRAM correctly but its own bank-switch code never got
; patched, so it just fell through back to DOS.
;
; This replicates test:'s exact matching logic (lines ~480-527) so /W-loaded
; games get the same treatment, but ends in a ret instead of a jp mega -
; called once from pinet:, right after page 0 has been fetched to 8000h and
; before mega:'s own "Loading file : 000%" counter starts (see pinet:'s own
; comment for why the timing matters), so restarting the load from mega:
; here would be wrong.
pinetguess:
        ld hl,8000h
        ld de,megabuf
        ld bc,400h      ; 1024 bytes - same amount testrom reads from disk
        ldir
        ld de,msg48
        call messg
        ld ix,megabuf
        call cheksum
        ld ix,megatbl
pinetr1:ld a,(ix)
        cp 255          ; end of table?
        jr z,pinetr3
        ld b,a          ; B=ROM mapper
        ld e,(ix+1)
        ld d,(ix+2)     ; DE=ROM signature
        xor a
        push hl
        sbc hl,de
        ld a,h
        or l            ; HL=DE?
        jr z,pinetr2
        ld de,3
        add ix,de       ; else next signature
pinetr11:ld a,(ix)
        inc ix
        cp 24h
        jr nz,pinetr11
        ld hl,guessn
        inc (hl)
        pop hl
        jr pinetr1
pinetr2:pop hl          ; ROM found in table:
pinetr21:ld a,b
        and 0Fh
        ld (guessr),a   ; save ROM mapper
        ld a,b
        and 00010000B
        ld (sccr),a     ; save SCC game flag
        ld de,3
        add ix,de
        push ix
        pop de          ; DE=ROM name
        call messg      ; print ROM name
        ret
pinetr3:call checkon    ; check if game is Konami with SCC by RC number
        cp 255
        jr nz,pinetr21  ; also didn't found?
        ld de,msg58     ; ROM not found in table...
        call messg
        ld a,255
        ld (guessn),a
        ret

;   *** SCC patch routine

sccptch:ld a,(sccr)     ; not a SCC game: return
        or a
        ret z
        ld a,(guessn)
        cp 255
        ret z           ; SCC game, but not detected? return
        ld a,(sccslt)
        cp 255
        ret z           ; no SCC on system? return
        ld a,1
        ld (doscc),a
        ld a,(mrslt)
        and 00000011B
        ld b,a
        ld a,(sccslt)
        and 00000011B
        cp b
        jr nz,sccptc1
        ld de,msg65     ; SCC in same primary slot of MegaRAM?
        jr sccptc3      ; warn user
sccptc1:ld b,a          ; B=SCC primary slot
        ld a,(0f343h)
        ld c,a
        ld a,(gmtype)
        or a
        jr z,sccptc4    ; Game Master I/II loaded?
        cp 1
        jr z,scctpc2
        ld a,(mpslt)
        ld c,a
scctpc2:ld a,c          ; and SCC in same primary slot of RAM/mapper?
        and 00000011B
        cp b
        jr nz,sccptc4
        ld de,msg68     ; warn user
sccptc3:xor a
        ld (doscc),a    ; disable scc
        call messg
        ld de,msg67
        call messg
        ld de,msg66
        call messg
        ld de,msg43
        call messg      ; warn user
        call patchf8    ; wait for response
        push af
        call crlf
        call crlf
        pop af
        cp 'Y'
        ret z           ; continue? ok...
        pop hl          ; else discard return address
        jp endprg       ; and terminate ExecROM
sccptc4:ld a,(sccslt)   ; set resident code data (SCC and MegaRAM slots)
        and 00000011B
        rlca
        rlca
        rlca
        rlca
        ld (sccres1+1),a
        ld a,(mrslt)
        ld hl,4000h
        call 0024h      ; enable MegaRAM at 4000h
        ld ix,scctable
        ld a,(guessn)
        ld b,a
        cp 37
        jp z,sccpen1    ; ROM is Pennant Race I? special treatment
        cp 38
        jp z,sccpen2  ; ROM is Pennant Race II? special treatment
sccpt50:ld a,(ix)
        cp 255
        jp z,sccptc8
        cp b
        jp nz,sccptc6
        ld l,(ix+1)
        ld h,(ix+2)
        ld a,h
        or l
        jr z,sccpt51
        ld a,0c3h
        ld (sccresi),a
        ld (sccresi+1),hl
sccpt51:ld l,(ix+3)
        ld h,(ix+4)
        ld a,h
        or l
        jr z,sccpt52
        ld a,0c3h
        ld (sccreso),a
        ld (sccreso+1),hl
sccpt52:push bc
        ld b,(ix+5)
        ld a,(ix+6)
        ld de,7
        add ix,de
        out (8eh),a
        ld (4000h),a
        in a,(8eh)
sccpt53:ld l,(ix)
        inc ix
        ld h,(ix)
        inc ix
        ld de,4000h
        add hl,de
        ld a,0cdh
        ld (hl),a
        inc hl
        ld de,sccadd
        ld (hl),e
        inc hl
        ld (hl),d
        djnz sccpt53
        ld b,(ix)
        ld a,(ix+1)
        ld de,2
        add ix,de
        out (8eh),a
        ld (4000h),a
        in a,(8eh)
sccpt54:ld l,(ix)
        inc ix
        ld h,(ix)
        inc ix
        ld de,4000h
        add hl,de
        ld a,0cdh
        ld (hl),a
        inc hl
        ld de,sccadd+sccres2-sccres
        ld (hl),e
        inc hl
        ld (hl),d
        djnz sccpt54
        pop bc
        ld a,(ix)
        inc ix
        cp 255
        jp z,sccptc7
        dec ix
        dec ix
        dec ix
        dec ix
        dec ix
        dec ix
        jp sccpt52
sccptc6:ld a,(ix+5)
        ld de,7
        add ix,de
sccpt60:push bc
        ld b,a
        ld de,2
sccpt61:add ix,de
        djnz sccpt61
        ld a,(ix)
        inc ix
        inc ix
        ld b,a
        ld de,2
sccpt62:add ix,de
        djnz sccpt62
        pop bc
        ld a,(ix)
        inc ix
        cp 255
        jp z,sccpt50
        inc ix
        jr sccpt60
sccptc7:call sccptc9    ; install resident code
        call setorig
        ld de,msg69
        call messg
        ret
sccptc8:xor a
        ld (doscc),a    ; disable scc
        ret
sccptc9:in a,(0a8h)     ; initial PPI restore value for SCC disable routine
        and 11111100B
        ld (sccres3+1),a
        ld hl,sccres    ; install resident code
        ld de,sccadd
        ld bc,sccresf-sccres
        ldir
        ret

; Patch Pennant Race I for SCC
sccpen1:ld hl,sccp1r1   ; install resident code
        ld de,pr1add
        ld bc,sccp1rf-sccp1r1
        ldir
        ld a,6
        out (8eh),a
        ld (0a000h),a   ; select page 6
        in a,(8eh)      ; write mode
        ld a,0c3h
        ld (0becch),a
        ld hl,pr1add
        ld (0becdh),hl  ; routine at BECCh
        ld (0b17bh),a
        ld hl,pr1add+sccp1r2-sccp1r1
        ld (0b17ch),hl  ; routine at B179h
        ld (0bf2ch),a
        ld hl,pr1add+sccp1r3-sccp1r1
        ld (0bf2dh),hl
        jp sccptc7

; Patch Pennant II for SCC
sccpen2:in a,(0a8h)
        and 11111100B
        ld (scpen2d+1),a
        and 11001111B
        ld b,a
        ld a,(sccslt)
        and 00000011B
        rlca
        rlca
        rlca
        rlca
        or b
        ld (scpen2h+1),a
        out (8eh),a
        ld a,0dh
        ld (0a000h),a
        in a,(8eh)      ; write mode
        ld hl,0a1f7h
        call scpen2x
        ld hl,0a202h
        call scpen2y
        ld hl,0a26ch
        call scpen2x
        ld hl,0a284h
        call scpen2y
        ld hl,0a2a4h
        call scpen2x
        ld hl,0a2dah
        call scpen2x
        ld hl,0a32ch
        call scpen2x
        ld hl,0a3b0h
        call scpen2y
        ld hl,0b06dh
        call scpen2y
        ld hl,0b29ah
        ld b,20h
        call scpen2w
        ld hl,0b29eh
        ld b,28h
        call scpen2w
        ld a,0c3h
        ld (0b29eh),a
        ld a,07eh
        ld (0b299h),a
        ld a,012h
        ld (0b29dh),a
        ld hl,0a2fah
        ld de,0a2fdh
        ld bc,25
        lddr
        ld a,17h
        ld (0a2e8h),a
        ld hl,0
        ld (0a2e2h),hl
        ld (0a2e3h),hl
        ld hl,0a352h
        ld de,0a355h
        ld bc,31
        lddr
        ld a,5dh
        ld (0a33ah),a
        ld hl,0
        ld (0a334h),hl
        ld (0a335h),hl
        ld a,0edh
        ld (0b3a4h),a
        ld hl,scpen22
        ld de,0b377h
        ld bc,scpen2f-scpen22
        ldir
        out (8eh),a
        ld a,0
        ld (0a000h),a
        in a,(8eh)      ; write mode
        ld hl,scpen21
        ld de,0a018h
        ld bc,scpen22-scpen21
        ldir
        jp sccptc7
scpen2x:ld b,20h
        jr scpen2z
scpen2y:ld b,28h
scpen2z:xor a
        ld (hl),a
        inc hl
        ld (hl),a
        inc hl
scpen2w:ld a,0cdh
        ld (hl),a
        inc hl
        ld a,b
        ld (hl),a
        inc hl
        ld a,40h
        ld (hl),a
        ret
scpen21:call 4020h
        ld (0988fh),a
        jr scpen2d-1
        push af
scpen2h:ld a,0
        call 013bh
        pop af
        ret
        push af
scpen2d:ld a,0
        call 013bh
        pop af
        ret
scpen22:xor a
        call 4018h
        ld b,20h
scpen23:ld a,(hl)        
        call 4020h
        ld (de),a
        call 4028h
        inc hl
        inc de
        djnz scpen23
        ld a,(0c2b1h)
        call 4018h
        ret
        ld b,20h
        ld a,(hl)
        call 4020h
        ld (de),a
        call 4028h
scpen2f:

; Pennant Race I SCC routines
sccp1r1:call sccadd             ; routine at BECCh (page 6)
        ld a,(hl)
        ld (de),a
sccp1fi:ld a,5
        jp sccres2-sccres+sccadd
sccp1r2:call sccadd             ; routine at B179h (page 6)
        xor a
        ld (988fh),a
        jr sccp1fi
sccp1r3:call sccadd             ; routine at BF2Ch (page 6)
        ld de,9860h
        xor a
        ld (988fh),a
        ld b,20h
sccp1r4:ld a,(hl)
        ld (de),a
        inc hl
        inc de
        djnz sccp1r4
        ld hl,988fh
        ld de,0eff3h
        ld a,(de)
        ld (hl),a
        jr sccp1fi
sccp1rf:

;sccres: di
