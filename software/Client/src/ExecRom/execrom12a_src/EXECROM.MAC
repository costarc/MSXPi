        db 3ah,42h,0f3h,32h,9fh,0f2h,3ah,43h,0f3h,32h,0a0h,0f2h,0c9h
        ; This patch disable GM2 DiskROM detection/initialization
        dw 15c9h
        db 4
        db 0,0,0,18h
        ; This patch avoid clearing RAM page 2 where GM2 is located
        dw 15b3h
        db 4
        db 0,0,0,0

        db 3,2
        dw 0e9dh
        db 6
        db 3,0d3h,0feh,0,0,0
        dw 0ea4h
        db 1
        db 0

