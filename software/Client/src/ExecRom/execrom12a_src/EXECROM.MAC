;        push bc
;        push de
;        push hl
;        ld h,80h
;sccres3:ld a,0
;        call 0024h
;        pop hl
;        pop de
;        pop bc
;        ld a,0c3h
;        ld (0fd9ah),a
;        pop af
;        ld (09000h),a
;sccreso:defb 0c9h,0,0
;sccresf:

setscc: ld a,(doscc)            ; enable SCC slot
        or a
        ret z                   ; not to enable SCC? return
        ld a,(sccslt)
        ld h,80h
        jp 0024h

; *** Print MegaRAM/Mapper/SCC slot in A, prefix message in DE

prtslot:push af
        call messg              ; print "Mapper/Megaram/SCC found:"
        ld de,msg14
        call messg              ; print "-Slot:"
        pop af
        push af
        and 00000011b
        call prtnum             ; print slot
        pop af
        bit 7,a                 ; expanded?
        ret z                   ; return if not
        push af
        ld e,'.'                ; print '.'
        call prtchr
        pop af
        and 00001100B
        srl a
        srl a                   ; subslot
        call prtnum
        ret

; *** Print the size in kbytes of MegaRAM (A=1) or Mapper (A=0)
; 
; input: B=last page

prtsize:ld hl,3030h
        ld (msg17),hl
        ld (msg17+2),hl ; zero size string
        ld      h,0
        ld      l,b
        inc     hl      ; HL = number of pages
        or      a
        jr      nz, ps1 ; MegaRam - 8K pages
        add     hl,hl
ps1:    add     hl,hl
        add     hl,hl
        add     hl,hl   ; HL = number of Kbytes
        ld      de,msg17
        ld      bc,1000
        call    digit
        ld      bc,100
        call    digit
        ld      bc,10
        call    digit
        ld      bc,1
        call    digit
        ld      de,msg16
        jp      messg   ; CALL + RET

; *** Search for MegaRAM or Mapper and return its slot 
; 
; input:  A=1: Search MegaRAM
;         A=0: Search Memory Mapper
;         A=2: Search SCC
; output: A=slot of MegaRAM/Mapper/SCC (255 if not found)
; WARNING! This is a destructive test for Memory Mapper!

findram:ld      (memtest),a
        xor     a
        ld      hl,0fcc1h       ; HL=expanded slot table
        ld      b,4             ; B=number of promary slots
fr1:    ld      (slot1),a
        ld      (slot2),a
        bit     7,(hl)          ; expanded?
        jr      nz,fr5
        call    ramtest
        jr      c,fr3
fr2:    inc     hl
        ld      a,(slot1)
        inc     a
        djnz    fr1
        ld      a,255
        jr      fr4
fr3:    ld      a,(slot2)
fr4:    call    setorig         ; restore slot configuration
        cp      255             ; set Z flag
        ret
fr5:    push    bc              ; search for MegaRAM/Mapper on expanded slots
        push    hl
        ld      e,0             ; E=subslot 0
        ld      b,4             ; B=number of subslots
fr6:    ld      a,e
        rla
        rla
        and     00001100B
        ld      c,a
        ld      a,(slot1)
        and     00000011B
        or      c
        set     7,a
        ld      (slot2),a       ; A=subslot in CALSLT format
        call    ramtest         ; search subslot
        jr      c,fr7           ; found
        inc     e
        djnz    fr6
fr7:    pop     hl
        pop     bc
        jp      nc,fr2
        jr      fr3
ramtest:push    bc              ; check for MegaRAM/Mapper in subslot in A
        push    de
        push    hl
        ld      hl,4000h
        ld      a,(memtest)
        cp      2
        jr      nz,ramtes1
        ld      hl,9000h        ; SCC is enabled only at 9000h
ramtes1:ld      a,(slot2)
        push    hl
        call    0024h
        pop     hl
        push    hl
        ld      a,(hl)
        push    af              ; save slot byte at addr 4000h/9000h
        ld      e,0ACh          ; first test
        call    testmm
        ld      e,0CAh          ; second test
        call    testmm
test1:  pop     af
        pop     hl
        ld      (hl),a          ; restore slot byte at addr 4000h/9000h
        scf                     ; flag C - sucess
        jr      ratest4
testmm: ld      a,(memtest)     ; test subslot for Mapper/MegaRAM (E=pattern)
        cp      1
        jr      z,testmr
        cp      2
        jr      z,testscc
testmp: out     (08eh),a        ; prevent confusing MegaRAM with Mapper
        ld      a,2
        out     (0fdh),a
        ld      a,e             ; E=pattern byte
        ld      (4000h),a
        ld      a,1
        out     (0fdh),a
        xor     a
        ld      (4000h),a
        ld      a,2
        out     (0fdh),a
        jr      ratest2
testscc:out     (8eh),a         ; avoid confusing MegaRAM with SCC
        ld      a,(9800h)
        push    af
        ld      a,03fh
        ld      (9000h),a       ; switch to SCC waveform buffer
        ld      a,e
        ld      (9800h),a
        xor     a
        ld      (9000h),a       ; disable SCC
        ld      (9800h),a       ; [if slot isn't SCC, pattern will be erased]
        ld      a,03fh          ; switch again to SCC waveform buffer
        ld      (9000h),a
        ld      a,(9800h)
        cp      e
        ex      af,af'
        pop     af
        ld      (9800h),a       ; restore byte at 9800h
        ex      af,af'
        pop     hl
        jr      nz,ratest3      
        jp      (hl)            ; we have RAM there? great! SCC!
testscf:
testmr: out     (08eh),a        ; MegaRAM ROM mode
        xor     a
        ld      (4000h),a       ; MegaRAM page 0
        in      a,(08eh)        ; MegaRAM RAM mode
        ld      a,e             ; E=pattern byte
        ld      (4000h),a
        out     (08eh),a        ; MegaRAM ROM mode
        xor     a
        ld      (4000h),a       ; MegaRAM page 0
ratest2:ld      a,(4000h)
        pop     hl              ; HL=return address
        cp      e               ; RAM?
        jr      nz,ratest3      ; no: go to fail routine
        jp      (hl)            ; yes: return
ratest3:pop     af              ; Fail routine:
        pop     hl
        ld      (hl),a          ; restore slot 4000h/8000h byte
        xor     a               ; flag NC - no success
ratest4:pop     hl              
        pop     de
        pop     bc
        ret

; *** Return the last page of MegaRAM or Mapper
;
; input:  A=1: MegaRAM
;         A=0: Memory Mapper
;         B  : MegaRAM/Mapper slot
; output: A  : last page
; WARNING! This is a destructive test!

sizetst:ld      (memtest),a
        ld      a,b
        ld      h,40h
        call    00024h          ; enable MegaRAM/Mapper at slot B
        ld      a,0
        call    sizechg
        ld      hl,msg2         ; put flag on page 0
        ld      de,4100h
        ld      bc,5
        ldir
        ld      a,(memtest)
        or      a
        jr      nz,st1
        ld      a,3             ; start Mapper test at page 3, MegaRAM at 1
st1:    ld      hl,4105h        ; clear test area
        ld      de,4106h
        ld      bc,5
        ld      (hl),0
        ldir
        call    sizechg
        ld      hl,messg+2
        ld      de,4105h
        ld      bc,5
        ldir                    ; copy test pattern
        push    af
        ld      hl,msg2
        ld      de,4100h
        ld      b,5
        call    compare         ; we reached again page 0?
        jr      z,st2           ; if yes, terminate test
        ld      hl,messg+2
        ld      de,4105h
        ld      b,5
        call    compare         ; this page is RAM?
        jr      nz,st2          ; if no, terminate test
        pop     af
        inc     a
        jr      st1             ; next page
st2:    ld      a,(memtest)     ; test end:
        or      a
        jr      nz,st3
        ld      a,3
st3:    dec     a
        call    sizechg         ; restore MegaRAM/Mapper page
        call    setorig
        pop     af
        dec     a
        ret
sizechg:push    af              ; select MegaRAM/Mapper page A at RAM page 1
        ld      a,(memtest)
        or      a
        jr      nz,sc1
        pop     af
        out     (0fdh),a
        ret
sc1:    pop     af
        push    af
        out     (08eh),a
        ld      (4000h),a
        in      a,(08eh)
        pop     af
        ret

;   *** Calculate initial address of 16k cartridges

calc16: call int1       ; address can be 0000h,4000h or 8000h
        cp 40h
        ret c
        ld hl,4000h
        cp 80h
        ret c
        ld hl,8000h
        cp 0d0h
        ret c
        ret

;   *** Calculate initial address of 32k/48k cartridges

calc32: call int1      ; address can be only 0000h or 4000h
        cp 40h
        ret c
        ld hl,4000h
        ret

; *** Execute BASIC program

gobasic:ld hl,gobas0
        ld de,rlcadd
        ld bc,gobas1-gobas0
        ldir
        ld a,0c3h
        ld (0fee4h),a
        ld hl,rlcadd
        ld (0fee5h),hl
        ld iy,(0f347h)
        ld ix,4022h
        jp 001ch
gobas0: ld sp,0c200h
        ld a,0c9h
        ld (0fee4h),a        
        ld a,(0fcc1h)
        ld h,40h
        call 0024h
        call 00cch
        ld a,0Ch
        rst 18h             ; clear screen
        ld hl,0c000h        ; set BASIC variables and run BASIC program
        ld (0f6c2h),hl
        ld hl,(08008h)
        inc hl
        ld (0f676h),hl
        ld a,0ffh
        ld (0fbb1h),a
        jp 073ach
gobas1:

gobasic_:call gobas11
        ld hl,0F340h
        ld a,(hl)
        ld (hl),h
        xor a
        ld (0F56Bh),a
;       ld sp,0C200h
;       ld a,(0F343h)
;       ld h,80h
;       call 0024h
;       ld a,(0FCC1h)
;       ld h,0
;       call 0024h
;       ld a,(0FCC1h)
;       ld h,40h
;       call 0024h
        ld hl,(0FC48h)
        xor a
        ld (hl),a
        inc hl
        ld (0F676h),hl
        ld (hl),a
        inc hl
        ld (hl),a
        inc hl
        ld (0F6C2h),hl
        ld hl,0FFFFh
        ld (0F41Ch),hl
        call gobasi1
        ld sp,(0F674h)
        ld a,0FFh
        ld (0F3DEh),a
        xor a
        ld (0fca9h),a
        ld hl,gobasi0
        ld de,0d000h
        ld bc,gobasi1-gobasi0
        ldir
        jp 0d000h
gobasi0:ld a,(0FCC1h)
        ld h,0
        call 0024h
        ld a,(0FCC1h)
        ld h,40h
        call 0024h
        ld a,0Ch
        rst 18h             ; clear screen
        ld hl,0c000h        ; set BASIC variables and run BASIC program
        ld (0f6c2h),hl
        ld hl,(08008h)
        inc hl
        ld (0f676h),hl
        ld a,0ffh
        ld (0fbb1h),a
        jp 073ach
gobasi1:ld hl,72AEh
        ld (0F323h),hl
        ld hl,5C67h
        ld (0F325h),hl
        ld hl,(0F349h)
        ld (0FC4Ah),hl
        ld a,(0F345h)
        ld c,a
        ld b,0
        ld de,25h
        call mulbcde
        call gobasi2
        ld (0F353h),hl
        ld bc,19h
        call gobasi2
        ld (0F378h),hl
        ex de,hl
        ld hl,gobasi3
	ldir
        ld hl,0FFF5h
        add hl,de
        ld (0F37Bh),hl
        ld a,(0F348h)
        ld de,0FFF9h
        add hl,de
        ld (hl),a
        ld de,0Eh
        add hl,de
        ld (hl),a
        call gobas12
gobas11:ld a,0C9h
        ld (0F368h),a
        ld (0F36Bh),a
        ld (0F36Eh),a
        ret
gobas12:ld a,1
        ld (0F85Fh),a
        ld hl,(0FC4Ah)
        ld de,0FDEAh
        add hl,de
        ld (0F860h),hl
        ld e,l
        ld d,h
        dec hl
        dec hl
        ld (0F672h),hl
        ld bc,0C8h
        and a
        sbc hl,bc
        push hl
        ld hl,0Dh
        add hl,de
        ld (0F862h),hl
        pop hl
        ld (0F674h),hl
        dec hl
        dec hl
        ld  (0F6B1h),hl
        ld  l,e
        ld  h,d
        inc hl
        inc hl
        inc hl
        inc hl
        ld a,2
gobas13:ex de,hl
        ld (hl),e
        inc hl
        ld (hl),d
        inc hl
        ex de,hl
        ld bc,7
        ld (hl),b
        add hl,bc
        ld (hl),b
        ld bc,102h
        add hl,bc
        dec a
        jr nz,gobas13
	ret
gobasi3:ld a,d
        cp 09h
        jp nc,6ec9h
        rst 30h
	nop
        and a
        ld l,d
        push hl
        jp 6ef4h
        ld a,d
        cp 9
        jp nc,6E95h
        rst 30h  
        defb 80h
        defw 69E7h
	ret

gobasi2:ld hl,(0FC4Ah)
        and a
        sbc hl,bc
        ld (0FC4Ah),hl
        jr c,gobas21
        ld a,h
        cp 0C2h
        ret nc
gobas21:ld de,gobas22
        ld c,9
        call 0F37Dh
        ld c,0
        jp 0F37Dh
gobas22:defm 'Not enough memory'
        defb 13,10,24h

;   *** General routines

mulbcde:ld hl,0         ; ** makes HL=BC*DE
        ld a,b
        ld b,11h
        jr mulbcd3
mulbcd1:jr nc,mulbcd2
        add hl,de
mulbcd2:rr h
        rr l
mulbcd3:rra
        rr c
        djnz mulbcd1
        ld b,a
	ret

filen:  ld de,name      ; ** put filename pointed by HL on FCB
        inc hl
        ld a,(hl)       ; get second character
        dec hl
        cp ':'          ; if is ':'
        jr nz,filen01   ; then drive is specified:
        ld a,(hl)       ; get drive name,
        and 223         ; make it uppercase
        sub 64          ; transform to drive specification (1=A, 2=B...)
        ld (fcb),a      ; and set FCB
        inc hl
        inc hl
filen01:ld a,(hl)       ; get name byte
        cp 33           ; if below space character,
        ret c           ; end file name
        cp '.'          ; if point, next is extension:
        jr nz,filen02
        inc hl          ; first character extension
        ld de,ext       ; set DE to FCB extension position
        ld a,32         ; clear extension
        ld (ext),a
        ld (ext+1),a
        ld (ext+2),a
        jr filen01      ; continue
filen02:ld (de),a       ; if not point, set FCB name position
        inc hl          ; next character
        inc de
        jr filen01      ; continue

srchco2:call srchcom    ; ** if option /'A' present (upper/lower), return Z
        ret z           ; test lowercase
        call upperc
        call srchcom    ; test uppercase
        ret

srchcom:push bc         ; ** verify command /X in command line (X=register A)
        ld hl,81h       ;    if found, HL points to character after /X
        ld c,a
        ld a,(080h)     ; and size
        ld b,a
srchcm1:ld a,(hl)       ; get a character
srchcm2:cp '/'          ; is '/'?
        inc hl
        jr nz,srchcm3   ; if not, repeat loop
        ld a,(hl)       ; else get next character
        cp c            ; is the command?
        jr z,srchcm4    ; if not, repeat loop
        jr srchcm2      ; else return
srchcm3:djnz srchcm1    ; repeat loop until end
        xor a
        cp 1            ; set NZ flag
srchcm4:ld a,c          ; restore A register
        inc hl
        pop bc
        ret             ; and return

printfn:ld hl,name      ; ** print file name on FCB with '.' and ':'
        ld b,8
        call prtnam
        ld e,'.'        ; print '.'
        call prtchr
        ld b,3
        ld hl,ext       
        call prtnam     ; print file extension
        ld e,':'
        call prtchr     ; print ':'
        ret

dskchg: ld a,'d'        ; ** verify /D option and wait disk change if yes
        call srchco2    ; option '/D' requested?
        ret nz          ; return if not
        ld de,msg30     ; print message,
        call messg
        ld c,8
        call 5          ; wait key,
        ld de,msg31
        call messg      ; erase message
        ret             ; and return

int1:   ld hl,0         ; ** get high nibble of ROM initial address
        ld a,(megabuf+3)      
        and 11110000b
        ret

dostype:ld de,msg60
        call messg
        ld a,(dosver)
        add a,30h
        ld e,a
        jp prtchr

msxtype:ld de,msg51     ; ** print MSX version
        call messg
        ld a,(msxver)
        call msxtyp2    ; test if MSX is CIEL MSX2+ Turbo
        ld a,(msxver)
        call msxtyp1    ; identify MSX type
        jp messg        ; print MSX type
msxtyp1:ld de,msg53      
        or a            ; test if is MSX1
        ret z
        ld de,msg54     ; test if is MSX2
        cp 1
        ret z
        ld de,msg55     ; test if is MSX2+
        cp 2
        ret z
        ld de,msg56     ; else MSX is Turbo R
        ret
msxtyp2:cp 2            ; test if MSX is CIEL MSX2+ Turbo:
        ret nz          ;       is MSX2+?
        ld hl,07eedh
        call msxtyp3
        cp '2'          ;       ROM BASIC is 3.2?
        ret nz
        ld hl,07f06h
        call msxtyp3    ;       (c) A.Carchano?
        cp 'A'
        ret nz
        ld hl,07f07h
        call msxtyp3
        cp '.'
        ret nz
        ld hl,07f08h
        call msxtyp3
        cp 'C'
        ret nz
        ld a,1          ;       so, set flag
        ld (acmsx2p),a
        pop de          ;       discards return to msxtype
        ld de,msg62
        jp messg        ;       print MSX type and return
msxtyp3:ld a,(0fcc1h)   ; [read byte in ROM address in HL]
        jp 000ch

blkrd:  push bc         ; ** read 8k from file to HL (update HL); A=2 if error
        push de         ;    A=file handle if DOS2
        push hl         
        push af
        ld a,(dosver)
        cp 2
        jr z,blkrd3
        pop af
        ld d,h
        ld e,l
        ld c,1ah        ; set DMA to HL
        call 5
        ld de,(openf)   ; DE points to actual file FCB
        ld hl,1
        ld c,27h
        call 5          ; read 8k (size was set by OPENFIL)
blkrd2: pop hl
        ld de,8192
        add hl,de       ; update HL
        pop de
        pop bc
        ret
blkrd3: pop af
        ld b,a
        ex de,hl
        ld hl,8192
        ld c,48h
        call 5
        or a            ; ok?
        jr z,blkrd2     ; return
        cp 0c7h         ; eof?
        ld a,1          ; set EOF code
        jr z,blkrd2     ; and return
        ld a,2          ; not eof? so is an error. set error code
        jr blkrd2       ; and return

prtchr: ld c,2          ; ** prints the character in 'E' on screen
        call 5
        ret

wrtperc:push bc         ; ** write percentage counter 'A' on screen
        push de
        push hl
        push af
        ld de,msg21     ; erase previous counter
        call messg
        pop af
        push af
        srl a           ; transform high nibble in low nibble
        srl a
        srl a
        srl a
        call prtnum     ; print high nibble
        pop af
        and 00001111b   ; get low nibble
        call prtnum     ; print high nibble
        ld e,'%'
        call prtchr     ; print '%'
        pop hl          ; restore registers
        pop de
        pop bc
        ret             ; return

prtnum: add a,30h       ; ** print number in A register
        ld e,a          ; transform to ASCII and put on E register
        call prtchr     ; print digit
        ret

read2:  push bc         ; ** read a 2 byte hex character in A; CY if error
        ld a,(hl)       ; get first nibble
        call cnvhex     ; convert
        jp nc,readerr   ; if error, warn
        ld b,a          ; save first nibble
        inc hl          
        call testsep    ; finish?
        jr z,read21     ; if yes, return
        ld a,b          ; shift nibble to left
        sla a
        sla a
        sla a
        sla a
        ld b,a          ; save nibble
        ld a,(hl)       ; get second nibble
        call cnvhex
        jp nc,readerr   ; if error, warn
        or b            ; add nibbles
        inc hl
read21: scf             ; clear carry flag
        ccf
        pop bc          ; restore register BC
        ret             ; return

read4:  ld bc,0         ; ** read a 4 byte hex address in BC; CY if error
        ld a,(hl)       ; get first nibble
        call cnvhex     
        jp nc,readerr   ; if error, warn 
        ld c,a          ; save first nibble
        inc hl
        call testsep    ; end?
        jr z,read41     ; so, return
        ld a,c          ; shift nibble to left...
        sla a
        sla a
        sla a
        sla a
        ld c,a          
        ld a,(hl)       ; and get real low nibble (byte LSB)
        call cnvhex
        jp nc,readerr   ; if error, warn
        or c            ; add nibbles
        ld c,a
        inc hl
        call testsep    ; end?
        jr z,read41     ; so, return
        call cnvhex     ; get nibble
        jp nc,readerr   ; if error, warn
        ld b,a          ; save high byte first nibble
        inc hl
        call testsep    ; end?
        jr z,read42     ; so, return
        ld a,b          ; else shift nibble to left...
        sla a
        sla a
        sla a
        sla a
        ld b,a
        ld a,(hl)       ; and get real low nibble (byte MSB)
        call cnvhex
        jp nc,readerr
        or b            ; add nibbles
        ld b,a
        inc hl          
        ld b,c          ; put LSB and MSB bytes in the right registers
        ld c,a
read41: xor a           ; clear carry flag
        ret             ; return
read42: push de         ; save register DE
        ld a,c          ; put low nibble at LSB to high nibble
        sla a
        sla a
        sla a
        sla a
        ld d,a          
        ld a,b
        or d            ; add the real LSB low nibble
        ld b,c          
        ld c,a          ; put LSB in register C
        ld a,b          ; put MSB high nibble to low nibble
        srl a
        srl a
        srl a
        srl a 
        ld b,a          ; put MSB in register B
        pop de          ; restore register DE
        xor a           ; clear carry flag
        ret             ; return

testsep:ld a,(hl)       ; ** verify if character in (HL) is "," or space
        cp ','          
        ret z           
        cp ' '
        ret             

cnvhex: call upperc     ; ** convert an hex nibble in A to value; CY if error
        sub 48          ; convert ASCII do decimal
        cp 10
        ret c           ; if is letter,
        sub 7           ; convert
        cp 16           ; verify range
        ret             ; return ok or error

readerr:ld de,msg25     ; ** display error in typed address and set flag CY
        call messg      ; display error message
        push bc
        ld a,32         ; set HL to command end
        ld bc,255
        cpir
        scf             ; set fail flag
        pop bc
        ret             ; return

chgpage:di              ; ** put MegaRAM 8kb page 'A' at 4000h
        push af
        push bc         
        push de
        push hl         ; save registers
        ld b,a         
        ld a,(type)     ; if is not a MegaROM cartridge,
        cp 2
        jr c,chgpag0
        jr chgpag2
chgpag0:ld a,(gmload)   ; but Game Master is loaded
        or a
        jr nz,chgpag2   
        ld a,(rommode)  ; or ROM is loaded in MegaRAM
        or a
        jr nz,chgpag2   ; enable the desired page else
        call setorig    ; enable the only one page: 0
chgpag1:pop hl          ; restore registers
        pop de
        pop bc
        pop af          
        ei
        ret
chgpag2:ld a,(mrslt)    ; else if is MegaROM, enable page 1/2 to MegaRAM
        ld hl,4000h     
        push bc
        call 0024h      
        pop bc
        out (8eh),a       
        ld a,b          ; enable MegaRAM page 'A' and 'A+1' at RAM page 1
        ld (4000h),a
        inc a
        ld (6000h),a
        ld b,a
        ld a,(type)
        or a
        jr z,chgpag1    ; if 16k, return
        ld a,(mrslt)
        ld hl,8000h
        push bc
        call 0024h      
        pop bc
        out (8eh),a     ; if 32k,
        ld a,b          ; enable MegaRAM page 'A+2' and 'A+3' at RAM page 2
        ld (8000h),a
        inc a
        ld (0a000h),a
        jr chgpag1      ; and return

testspc:ld a,(hl)       ; ** test for ',' separator in command; CY if no ok
        cp ','          ; test for ','
        call nz,readerr ; display error if not
        jr c,testsp1   
        inc hl          ; else update HL if yes
testsp1:ret

fillram:call chgpage    ; ** fill address from HL to DE with C at page A
        dec hl          ; change page and initialize HL
fillra1:inc hl          ; next address
        ld a,c
        ld (hl),a       ; put byte
        ld a,h
        cp d
        jr nz,fillra1   ; verify end
        ld a,l
        cp e
        jr nz,fillra1   ; continue if not else
        ret             ; return

messg:  push af         ; ** print a message pointed by DE and delimited by $
        push bc         ; save all registers
        push de        
        push hl        
        ld c,9          ; call routine 9
        call 5          ; (print message)
        pop hl          ; restore all registers
        pop de
        pop bc
        pop af
        ret             ; and return

prtnam: ld a,(hl)       ; ** print uppercase B chars, ignoring space, at HL
        call upperc
        cp 32           ; is space?
        ld e,a
        push bc         ; save registers
        push de
        push hl
        call nz,prtchr  ; if not space, print
        pop hl
        pop de
        pop bc
        inc hl          ; next character
        djnz prtnam
        ret             ; return

upperc: cp 97           ; ** make A uppercase
        ret c
        cp 122
        ret nc
        sub 32
        ret

crlf:   ld de,msg57     ; ** jump a line
        jp messg

inifile:push af         ; ** set register variables for FCB/FIB of file
        push bc         ;    if DOS1, FCB is pointed by (openf)
        push de         ;    if DOS2, file handle in B
        push hl
        ld a,(dosver)
        cp 2
        jr z,inifil2
        ld ix,(openf)   
        ld (ix+14),0    ; set register size to 2000h (8k)
        ld (ix+15),20h
        ld (ix+31),0    ; set initial sequencial block to 0
        ld (ix+32),0    ; set initial register to 0
        ld (ix+33),0    
        ld (ix+34),0    
        ld (ix+35),0  
        jr inifil3
inifil2:ld hl,0
        ld de,0
        ld a,0
        ld c,4ah
        call 5
inifil3:pop hl
        pop de
        pop bc
        pop af
        ret

openrom:ld a,(dosver)   ; ** open a ROM file (FCB for DOS1, FNAMADR for DOS2)
        cp 2
        jr z,openro2
        ld de,fcb
        ld c,0fh
        call 5
        or a
        ret nz          ; no error?
        ld de,fcb       ; so get ROM file size
        ld c,23h
        call 5
        ld hl,(sizel)
        ld (romsize),hl
        ld hl,(sizeh)
        ld (romsize+2),hl
        ret
openro2:ld de,(fnamadr)
        ld a,00000001b  ; read-only mode
        ld c,43h
        call 5
        push af
        push bc
        or a
        jr nz,openro3   ; ROM opened ok?
        ld de,(fnamadr)
        ld b,0          ; so get ROM file size
        ld c,40h
        ld ix,fib
        call 5
        ld hl,(fib+21)
        ld (romsize),hl
        ld hl,(fib+23)
        ld (romsize+2),hl
openro3:pop bc          ; and return file handle
        ld a,b
        ld (fhandle),a
        pop af
        ret

opengm: ld a,(dosver)   ; ** open Game Master (1 or 2) ROM
        cp 2
        jr z,opengm2    ; in DOS1:
        ld de,gmaster   ; open Game Master I
        ld c,0fh
        call 5
        or a
        ret nz          ; no error?
        ld de,gmaster   ; so get Game Master I file size
        ld (openf),de
        ld c,23h
        ld hl,(sizegm)
        ld (gmsize),hl
        ld hl,(sizegm+2)
        ld (gmsize+2),hl
        jp 5
opengm2:ld hl,(gmnadr)  ; try opening Game Master I at ROM directory
        ld de,(fileadr)
        ld bc,12
        ldir
        ld de,romdir
        ld a,00000001b  ; read-only mode
        ld c,43h
        call 5
        ld de,romdir
        or a
        jr z,opengm3    ; not there?
        ld de,(gmnadr)  ; so try opening GM1 at local directory
        ld a,00000001b  ; read-only mode
        ld c,43h
        call 5
        ld de,(gmnadr)
opengm3:push af
        push bc
        or a
        jr nz,opengm4   ; GM opened ok?
        ld b,0          ; so get GM file size
        ld c,40h
        ld ix,fib
        call 5
        ld hl,(fib+21)
        ld (gmsize),hl
        ld hl,(fib+23)
        ld (gmsize+2),hl
opengm4:pop bc          ; and return file handle
        ld a,b
        ld (thandle),a
        pop af
        ret

openxpc:push hl         ; ** open XPC file and print "name.ext:"
        ld hl,fcb       ;    HL=filename beggining, no subdir (uses ROM dir)
        ld de,fcb+1
        ld bc,36
        ld (hl),0
        ldir            ; clear FCB
        ld hl,name      ; clear filename
        ld de,name+1
        ld bc,8
        ld (hl),32
        ldir
        ld a,'X'        ; set extension to XPC
        ld (ext),a
        ld hl,'CP'
        ld (ext+1),hl
        pop hl
        call filen      ; get filename
        call printfn    ; print filename
        ld a,(dosver)
        cp 2
        jr z,openxp2
        ld de,fcb
        ld c,0fh
        jp 5
openxp2:ld a,32
        ld (ext),a
        ld de,name
        ld hl,(fileadr)
openxp3:ld a,(de)
        cp 32
        jr z,openxp4
        ld (hl),a
        inc hl
        inc de
        jr openxp3
openxp4:ld (hl),'.'
        inc hl
        ld (hl),'X'
        inc hl
        ld (hl),'P'
        inc hl
        ld (hl),'C'
        inc hl
        ld (hl),0
        ld de,romdir
        ld a,00000001b
        ld c,43h
        call 5
        push af
        ld a,b
        ld (thandle),a
        pop af
        ret

parsdir:ld a,(dosver)   ; ** parse directory if DOS2
        cp 2
        ret nz
        ld de,(fnamadr) ; DE=pathname beginnng
        ld b,0
        ld c,5bh
        call 5          ; analize path
        or a
        jr nz,parsdi4   ; error?
        xor a           ; HL=filename address in pathname
        ld (nameadr),hl
        ld de,(fnamadr)
        sbc hl,de
        ld a,h
        or l
        jr z,parsdi1
        push hl
        pop bc
        ld hl,(fnamadr)
        ld de,romdir
        ldir
        ld (fileadr),de
parsdi1:ld hl,(fnamadr)
parsdi2:ld a,(hl)       ; find ROM filename extension
        or a
        jr z,parsdi3
        cp '.'
        jr z,parsdi3
        inc hl
        jr parsdi2
parsdi3:ld (hl),'.'
        inc hl          ; substitute extension to XPC
        ld (romext),hl
        ld (hl),'R'
        inc hl
        ld (hl),'O'
        inc hl
        ld (hl),'M'
        inc hl
        ld (hl),0
        ld hl,(nameadr)
        ret
parsdi4:pop de          ; restore return adress of CALL PARSDIR
        jp errdir       ; display invalid directory message error

setdma: ld c,1ah        ; ** set DMA do address in DE
        jp 5

closet: ld a,(dosver)   ; ** close filehandle in THANDLE if DOS2
        cp 2
        ret nz
        ld a,(thandle)
closet1:ld b,a
        ld c,45h
        jp 5

closef: ld a,(dosver)   ; ** close filehandle in FHANDLE if DOS2
        cp 2
        ret nz
        ld a,(fhandle)
        jr closet1

redfile:push af         ; ** read HL bytes at DMA from a file
        ld a,(dosver)
        cp 2         
        jr z,redfil2    ; in DOS1:
        pop af
        ld de,1
        ld ix,(openf)
        ld (ix+14),e
        ld (ix+15),d
        ld (ix+33),d
        ld (ix+34),d
        ld (ix+35),d
        ld (ix+36),d
        ld de,(openf)
        ld c,27h
        jp 5            ; read bytes
redfil2:push hl
        ld c,57h
        call 5          ; DE=DMA
        pop hl
        pop af
        ld b,a
        ld c,48h
        jp 5

testrom:push de         ; ** read file at DE and test if it's ROM
        push af         ;    in DOS1, file in (openf)
        call setdma     ;    in DOS2, filehandle in A
        pop af
        ld hl,1024
        call redfile
        or a            
        jr nz,testro1   ; go to testro1 if not ok
        pop de
        push de
        push de
        pop ix
        call cheksum    ; make checksum of ROM
        ld de,rtypesig
        or a
        sbc hl,de       ; original R-Type?
        pop de
        ret z           ; so, no AB signature, ok, return
        ld a,(de)       ; if not:
        cp 'A'          ; is a true cartridge?
        jr nz,testro2   ; if not, error
        inc de
        ld a,(de)   
        cp 'B'
        jp nz,testro2
        ret             ; else return
testro1:pop de          ; DE pushed in routine begginning
        pop de          ; return address
        jp error
testro2:pop de          ; return address
        jp errorf

loadrom:ld (loadro2+1),de;** read ROM file at HL (A blocks), go to DE, C=%
        push af         ;    (in DOS1, file in OPENF)
        ld a,b          ;    (in DOS2, filehandle in B)
        ld (lhandle),a
        pop af
        call inifile    ; initialize file FCB
        ld b,a
        ld d,0
loadro1:ld a,(lhandle)
        call blkrd      ; read 8k
        cp 2
        jp z,error      ; if error, warn and terminate
        ld a,d
        add a,c
        daa
        ld d,a          ; adjust percentage counter and show it
        call wrtperc    
        djnz loadro1    ; next block
        ld de,msg22     
        call messg      ; print '100%'
loadro2:jp 0000         ; go to DE address

setd800:push af         ; *** set mode to R800 DRAM if machine is a TR
        push bc
        push ix
        push iy
        ld a,11001101b  ; R800 DRAM mode
        and 2h
        xor 82h
        ld b,a
setd801:ld a,(msxver)
        cp 3            ; if not TR, return
        jr nz,setr802
        ld a,b          ; set CPU mode
        ld iy,0
        ld ix,0180h
        call 001ch
setr802:pop iy
        pop ix
        pop bc
        pop af
        ret

setr800:push af         ; *** set mode to R800 ROM if machine is a TR
        push bc
        push ix
        push iy
        ld a,01000100b  ; Z80 mode
        and 02h
        xor 81h
        ld b,a
        jr setd801

setz80: push af         ; *** set mode to Z80 if machine is a TR
        push bc
        push ix
        push iy
        ld a,11001110b  ; Z80 mode
        and 02h
        xor 82h
        ld b,a
        jr setd801

setorig:di              ; *** select original slot/subslot configuration
        push af
        ld a,(ppiset1)
        out (0a8h),a
        ld a,(ppiset2)
        cpl
        ld (0ffffh),a
        pop af
        ei
        ret

getr800:push af         ; *** save CPU mode if machine is a TR
        push ix
        push iy
        ld a,(msxver)
        cp 3            ; if not TR, return
        jr nz,getr802
        ld a,'8'        ; test for
        call srchcom    ; '/8' command
        jr nz,getr801   ; if present,
        ld hl,setr800
        ld (set800+1),hl; prevent not using R800 DRAM in TR
getr801:ld iy,0         ; get CPU mode
        ld ix,0183h
        call 001ch
        ld (r800cpu),a
getr802:pop iy
        pop ix
        pop af
        ret

set800: jp setd800      ; *** set R800 DRAM or ROM (if /X specified)

endwmsg:call messg      ; *** print message in DE, terminate program

endprg: call yemmd2     ; *** terminate program
        ld a,(msxver)    
        cp 3
        ret nz          ; if machine is not TR, return to MSXDOS
        ld hl,setz80
        ld a,(r800cpu)  ; else verify CPU state before ExecROM
        cp 0
        jr z,endprg1
        ld hl,setr800
        cp 1
        jr z,endprg1
        ld hl,setd800
endprg1:jp (hl)         ; restore this state and terminate program

idendos:ld de,0         ; *** identify MSXDOS (1 or 2)
        ld c,6fh        
        call 5          ; try getting DOS2 version
        ld a,d          
        or e            
        cp 0            ; if DOS2, DE contains MSXDOS2.SYS version, not 0
        ret z
        ld a,2
        ld (dosver),a
        ret

compare:ld a,(de)       ; *** compare regions in HL/DE, size in B, Z if match
        cp (hl)
        ret nz
        inc hl
        inc de
        djnz compare
        ret

digit:  ld a,-1         ; ** do HL/BC and output to DE
dg1:    inc a           ;    (A=HL/BC,HL=HL%BC,DE++)
        or a            ; is this needed ???
        sbc hl,bc
        jr nc,dg1
        add hl,bc       ; restore remainder
        add a,'0'
        ld (de),a       ; write digit
        inc de
        ret

shwscc: ld de,msg64     ; *** print SCC slot
        ld a,(sccslt)
        jp prtslot

shwmap: ld de,msg18     ; *** print Mapper slot/size
        ld a,(mpslt)
        call prtslot    ; print "Mapper found" and slot
        ld a,(mpslt)
        ld b,a
        xor a
        call sizetst    ; calculate size
        ld (mpsize),a
        ld b,a
        xor a
        jp prtsize      ; print size

shwmega:ld de,msg13     ; *** print MegaRAM slot/size
        ld a,(mrslt)
        call prtslot    ; print "MegaRAM found" and slot
        ld a,(mrslt)
        ld b,a
        ld a,1
        call sizetst    ; calculate size
        ld (mrsize),a
        ld b,a
        ld a,1
        jp prtsize      ; print size

setmrtp:call setmrt1    ; *** get MegaRAM size in comparison with MegaROMs
        ld a,b          ; [see type table below]
        ld (megatyp),a
        ret
setmrt1:ld b,6
        ld a,(mrsize)
        cp 16
        ret c
        ld b,7
        cp 32
        ret c
        ld b,9
        cp 64
        ret c
        ld b,10
        ret

cheksum:ld bc,512       ; *** make checksum in HL of ROM header in IX
        ld hl,0         ; HL=checksum
cheksu1:ld e,(ix)
        ld d,(ix+1)     ; DE=word
        add hl,de
        inc ix
        inc ix          ; HL=HL+DE
        dec bc
        ld a,b
        or c
        jr nz,cheksu1
        ret

clearm: ld a,'m'        ; *** clear MSXDOS/hooks if /M specified
        call srchco2 
        ret nz
        di              ; disable interruptions to clear DOS memory area
        pop ix          ; IX=return address (avoid crash if SP cleared)
        ld hl,0db00h
        ld de,0db01h
        ld bc,014ffh
        ld (hl),0
        ldir            ; clear DOS memory area
        ld hl,0fd9ah
        ld de,0fd9bh
        ld bc,0022fh
        ld (hl),0c9h
        ldir            ; restore all hooks
        push ix
        pop hl
        jp (hl)         ; return

stpdrv: ld de,msg29     ; *** stop drive
        call messg      ; STOPDRIVE routine: the countdown of drive is
                        ;                    controled by interrupt hook. So,
                        ;                    call interrupt hook 255 times.
        di              ; disable interrupts
        ld b,255        ; loop size
stpdr1: push bc
        call 0fd9fh
        pop bc
        djnz stpdr1     ; repeat loop
        ret

setbdhk:ld a,0c9h       ; *** clear BDOS hooks pointing to MSXDOS kernel
        ld (0f368h),a
        ld (0f36bh),a
        ld (0f36eh),a
        ret

ac2ptof:ld a,(acmsx2p)  ; *** disable turbo on CIEL MSX2+ Turbo
        or a
        ret z
        in a,(0b6h)
        and 07fh
        out (0b6h),a
        ret

nommd2: ld a,(dosver)   ; *** disable DOS2 memory mapper control
        cp 2
        ret nz          ; not DOS2? return
        di           
        ld hl,0d000h
        ld bc,02fffh
nommd21:ld a,03ah       ; search for 3Ah (LD A,)
        cpir
        jr nz,nommd22
        inc hl
        ld a,(hl)
        cp 0f2h
        jr nz,nommd21   ; search for 3A Cx F2 (7<=x<=A)
        dec hl
        ld a,(hl)
        cp 0c8h
        jr c,nommd21
        cp 0cbh
        jr nc,nommd21
        dec hl
        ld (hl),0dbh    ; change LD A,(F2Cx) to IN A,Fy/NOP (C<=y<=F)
        inc hl
        ld a,(hl)
        sub 0c7h
        add a,0fch
        ld (hl),a
        inc hl
        ld (hl),0
        jr nommd21
nommd22:ei
        ret

yemmd2: ld a,(dosver)   ; *** re-enable DOS2 memory mapper control
        cp 2
        ret nz          ; not DOS2? return
        di           
        ld hl,0d000h
        ld bc,02fffh
yemmd21:ld a,0dbh       ; search for DBh (IN A,(x))
        cpir
        jr nz,yemmd22
        inc hl
        ld a,(hl)
        cp 0
        jr nz,yemmd21   ; search for DB Fx 00 (C<=x<=F)
        dec hl
        ld a,(hl)
        cp 0fch
        jr c,yemmd21
        cp 0ffh
        jr nc,yemmd21
        dec hl
        ld (hl),03ah    ; change IN A,Fxh/NOP to 3A Cy F2 (7<=y<=A)
        inc hl
        ld a,(hl)
        sub 0fch
        add a,0c7h
        ld (hl),a
        inc hl
        ld (hl),0f2h
        jr yemmd21
yemmd22:ld a,(0f2c8h)   ; select pages refered by DOS2 in mapper
        out (0fdh),a
        ld a,(0f2c9h)
        out (0feh),a
        ei
        ret

;   *** Error messages routines

errorf: ld de,msg10     ; print message 10 (wrong file type)
        jp endwmsg
errort: pop de          ; clear stack
        pop de
        ld de,msg9      ; print message 9 (cartridge unknown)
        jp endwmsg
errorc: ld de,msg11     ; print message 11 (cartridge error)
        jp endwmsg
error:  call crlf       ; jump to next line
        cp 2            ; error reading?
        jr z,ioerr      ; if yes, go to ioerr
notfnd: ld de,msg3      ; print message 3 (file not found)
        jp endwmsg
ioerr:  ld de,msg4      ; print message 4 (I/O error)
        jp endwmsg
errdir: ld de,msg59     ; print message 59 (invalid directory)
        jp endwmsg
help:   ld de,msg2      ; print message 2 (help page 1)
        call messg
        ld c,8          ; wait a key
        call 5
        cp 27           ; if ESC, abort
        ret z
        ld de,msg2b     ; print message 2b (help page 2)
        call messg
        ld c,8          ; wait a key
        call 5
        cp 27           ; if ESC, abort
        ret z
        ld de,msg2c     ; print message 2c (help page 3)
        jp endwmsg

;   *** Program messages and variables

; cartridge types definition: db a,b,c,d,e,f,g,"h"
; where: a,b,c,d - size at FCB (hex base)
;        e       - number (internal definition)
;        f       - size in 8k blocks
;        g       - percentage advance in counter by pass (in BCD)
;        "h"     - long description
; OBS1.: (g*f must be equal or close to 100)
;
; OBS2.: 512k MegaROM cartridge have a patch on counter advance for
;        better counter performance (see routine 'mega')

type1:  db 000,064,00,0, 0, 02, 49h, '16k, ROM     $'
type2:  db 000,128,00,0, 1, 04, 24h, '32k, ROM     $'
type3:  db 000,192,00,0, 2, 06, 15h, '48k, MegaROM $'
type4:  db 000,000,01,0, 3, 08, 12h, '64k, MegaROM $'
type5:  db 000,128,01,0, 4, 12, 08h, '96k, MegaROM $'
type6:  db 000,192,01,0, 5, 14, 07h, '112k, MegaROM$'
type7:  db 000,000,02,0, 6, 16, 06h, '128k, MegaROM$'
type8:  db 000,000,04,0, 7, 32, 03h, '256k, MegaROM$'
type9:  db 000,000,06,0, 8, 48, 02h, '384k, MegaROM$'
typeA:  db 000,000,08,0, 9, 64, 03h, '512k, MegaROM$'
notype: db 255

; program messages

msg1:   db 1bh,78h,35h,13,10
        db 'ExecROM vr. 1.3',13,10
        db 'for the MSX system',13,10
        db '(c) 1996-1999,2001-2002 A&L Software',13,10,'$'
msg2:   db 13,10,'Syntax:ExecROM [options] d:file.rom',13,10
        db 'if extension is omited, assume .ROM',13,10,13,10
        db 'options: /8 - don''t use R800DRAM in TR',13,10
        db '         /B - reset MSX to execute file',13,10
        db '         /C - change cartridge byte',13,10
        db '         /D - change disk before load',13,10
        db '         /E - don''t load CoolColors',13,10
        db '         /F - fill cartridge area',13,10
        db '         /G1- load Game Master I',13,10
        db '         /G2- load Game Master II',13,10
        db '         /H - show this help',13,10
        db '         /I - skip autoload patchfile',13,10
        db '         /M - clear MSXDOS',13,10
        db '         /N - load 16/32K in MegaRAM',13,10
        db '         /Pn- load patchfile <n> (.XPC)',13,10
        db '         /R#- set MegaROM type',13,10
        db '         /S - set resident cartridge',13,10
        db 13,10,'Press a key to continue (ESC abort)...$'
msg2b:  db 1bh,4dh,1bh,41h,13
        db '         /Tx- set MSX as type x',13,10
        db '         /X - don''t execute cartridge',13,10
        db '         /Y - say YES to all questions',13,10
        db '         /U - don''t enable SCC',13,10
        db '         /W - load over MSXPi network instead of disk',13,10
        db '         /Z - execute ROM in R800 mode',13,10,13,10
        db 'syntax: /Cpp,eeee,bb',13,10
        db '        /Fp1,p2,eee1,eee2,bb',13,10
        db '        where: pp   - page',13,10
        db '               p1   - initial page',13,10
        db '               p2   - final page',13,10
        db '               eeee - address',13,10
        db '               eee1 - initial address',13,10
        db '               eee2 - final address',13,10
        db '               bb   - byte to put',13,10
        db '        *All values must be in hex',13,10
        db '        *Only use pages for MegaROMs',13,10,13,10
        db 'MegaROM types:',13,10
        db '        0-Konami 8kb    1-Konami 16kb',13,10
        db '        2-Konami5 8kb   3-Konami4 8kb',13,10
        db '        4-ASCII 8kb     5-ASCII 16kb',13,10
        db 13,10,'Press a key to continue (ESC abort)...$'
msg2c:  db 1bh,4dh,1bh,41h,13
        db '        (type 0 is default)',13,10
        db 13,10
        db 'MSX types:',13,10
        db '        I-international J-japanese',13,10
        db '        1-MSX1          2-MSX2',13,10
        db '        +-MSX2+         T-MSX TR',13,10,13,10
        db 'ExecROM is (c) 1996-1999,2001-2002 A&L Software',13,10
        db 'Internet e-mail:alsoftware@alsoftware.com.br',13,10,'$'
msg3:   db 13,10,'File not found',13,10,'$'
msg4:   db 13,10,'Error reading file',13,10,'$'
msg5:   db 13,10,'Loading file $'
msg6:   db 13,10,'- Executing ROM cartridge$'
msg7:   db 13,10,13,10,'Can''t execute a MegaROM cartridge',13,10,'$'
msg8:   db 13,10,'- Cartridge type: $'
msg9:   db 'unknown',13,10,13,10,'Program aborted',13,10,'$'
