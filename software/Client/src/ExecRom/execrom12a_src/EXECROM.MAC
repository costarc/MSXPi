; Resident SCC routines
sccres: jr sccres0
sccres0:ld a,sccresc-sccres0
        ld (sccadd+1),a
        in a,(0a8h)
        ld (sccres3+1-sccres+sccadd),a
        and 11001111B
sccres1:or 00010000B
        ld (sccresc+1-sccres+sccadd),a
sccresc:ld a,0
        out (0a8h),a
        ld a,03fh
        ld (09000h),a
sccresi:defb 0c9h,0,0
sccres2:push af
sccres3:ld a,0
        out (0a8h),a
        pop af
        ld (09000h),a
sccreso:defb 0c9h,0,0
sccresf:

;sccres: ld a,0c9h
;        ld (0fd9ah),a
;        push bc
;        push de
;        push hl
;        ld h,80h
;sccres1:ld a,0
;        call 0024h
;        pop hl
;        pop de
;        pop bc
;        ld a,03fh
;        ld (09000h),a
;sccresi:defb 0c9h,0,0
