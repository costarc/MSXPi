        dw 0b3eh
        db 4
        db 7,0d3h,0feh,0
        dw 0b4ch
        db 4
        db 6,0d3h,0feh,0

        db 7,2
        dw 0b3eh
        db 4
        db 7,0d3h,0feh,0
        dw 0b4ch
        db 4
        db 6,0d3h,0feh,0

gm2cnvf:db 0ffh

