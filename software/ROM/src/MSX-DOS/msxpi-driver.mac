; MSXPi Driver v1.6 (2026)

; Work area layout and load address of the Ethernet UNAPI driver appended at
; the end of this ROM.  Shared verbatim with the sjasm build of that driver.
INCLUDE unapi_wrk.inc

CONTROL_PORT1 EQU $56
CONTROL_PORT2 EQU $57
DATA_PORT1 EQU $5A

TEXTTERMINATOR EQU 0
BDOS           EQU 5
BUSYRETRIES    EQU 2
RESET          EQU $FF

STARTTRANSFER  EQU $A0
SENDNEXT       EQU $A1
ENDOFTRANSFER  EQU $A2
READY          EQU $AA
ABORT          EQU $AD
BUSY           EQU $AE

RC_SUCCESS     EQU $E0
RC_CRCERROR    EQU $E2
RC_OUTOFSYNC   EQU $E5

; symbols which can be used from the kernel

; errorcodes used by DSKIO, DSKCHG and GETDPB
;
; 0	write protect error
; 2	not ready error
; 4	data (crc) error
; 6	seek error
; 8	record not found error
; 10	write fault error
; 12	other error

; errorcodes used by DSKFMT
;
; 0	write protect error
; 2	not ready error
; 4	data (crc) error
; 6	seek error
; 8	record not found error
; 10	write fault error
; 12	bad parameter
; 14	insufficient memory
; 16	other error

; Size of the disk driver work area the kernel allocates for us.  Offsets
; 0..4 are DSKIO_SECTINFO's, 5..7 are MSXPI_GETSTASH's, and everything from
; UNAPI_WRK up belongs to the Ethernet UNAPI driver appended at the end of
; this ROM - see asm-common/include/unapi_wrk.inc.
; No private sector buffer: page-1 sectors are staged through the kernel's
; $SECBUF (see DSKIO_BUFFER). 512 more bytes here left a Panasonic FS-A1F
; below its A1 Cockpit's HIMEM >= D200h check ("not enough memory" at boot).
MYSIZE		equ	UNAPI_WRKEND	; Size of environment
SECLEN		equ	512		; Size of biggest sector

; INIHRD
;
; Input:	None
; Output:	None
; Changed:	af,bc,de,hl,IX,IY may be affected

; Remark: This i called twice. I distinguish the 1st and 2nd verifyig reggister A.
; A = #40 in first call, and #80 in second all.;
;
INIHRD:
        ; Called twice, with $40 then $80 (see the note above), so bit 7
        ; alone tells the two apart - one byte cheaper than comparing, and
        ; that byte is what let DSKIO_RXSIZE grow.
        bit     7,h
        ret     nz
        ld      hl,MSXPIVERSION
        call    PRINT
        ; About 1.4 s at 3.58 MHz (6 x 256 x 256 DJNZ): time to read the
        ; banner. The kernel ignores INIHRD's registers and flags.
        ld      d,6
INIDELAY:
        djnz    INIDELAY
        dec     c
        jr      nz,INIDELAY
        dec     d
        jr      nz,INIDELAY
        ret
        
; START OF -----------------------------
; MSXPi DRIVES Routine          |
;---------------------------------------
; DRIVES
;
; Input: 	F	Zx set if to return physical drives
;			    Zx reset if to return at least 2 drives, if only one
;			  physical drive it becomes a phantom drive
; Output:	L	number of drives
; Changed:	F,hl,IX,IY may be affected
;
; Remark:	DOS1 does not handle L=0 correctly. It hangs the computer upon boot if L = 0.
; During boot this is called twice, with BC = FB21 and then BC = FB23.

DRIVES:
		ld		l,1
		ret	z
		ld		l,2
		ret

; END OF -------------------------------
; MSXPi DRIVES Routine          |
;---------------------------------------

; INIENV
;
; Input: 	None
; Output:	None
; Changed:	af,bc,de,hl,IX,IY may be affected
;
; Remark:	examples installs own interrupt handler, but this is NOT required.
;		depends on the hardware if this is needed.

INIENV:
        ; Hand over to the Ethernet UNAPI driver at the end of this ROM: it
        ; hooks EXTBIO and initialises its part of the work area, then
        ; returns.  INIENV is the right moment - the kernel has by now
        ; allocated the MYSIZE work area and stored it in SLTWRK, and the
        ; EXTBIO hook has been initialised (by this diskrom or by whichever
        ; one started the disk system first).
        jp      UNAPI_ORG

; START OF -----------------------------
; MSXPi DSKIO Routine           |
;---------------------------------------
; DSKIO
;
; Input: 	A	Drivenumber
;		F	Cx reset for read
;			Cx set for write
; 		B	number of sectors
; 		C	Media descriptor
;		de	logical sectornumber
; 		hl	transfer address
; Output:	F	Cx set for error
;			Cx reset for ok
;		A	if error, errorcode
;		B	if error, remaining sectors
; Changed:	af,bc,de,hl,IX,IY may be affected
;
; Option A, the shared-channel guard.  MSXPi is ONE channel: the disk and the
; Ethernet UNAPI both drive ports 56/57/5A, and InterNestor Lite polls from the
; 50/60Hz timer interrupt.  Without this, a timer tick landing part-way through
; a block transfer makes the ISR issue its own IN ($5A) and both byte streams
; desynchronise permanently - silently, onto a filesystem.
;
; A flag rather than DI: a 512-byte block is ~28ms and disabling interrupts for
; that long would break JIFFY, key repeat and INL's own timers.  And a plain
; flag is enough without any atomicity worry, for the same reason ETH_LOCK
; needs no DI - the two contexts are asymmetric.  The foreground sets the flag
; before touching a port; an interrupt arriving before that finds the link free
; and completes its whole transaction before the foreground resumes, because
; the ISR runs to completion and cannot itself be preempted.
;
; Wrapped around DSKIO as a whole rather than around the individual block
; routines in msxpi_bios.asm: those nest and have several error exits each, so
; bracketing them would need a depth counter and would be easy to get wrong.
; DSKIO has one entry and every exit is a plain RET, so one CALL covers it.
DSKIO:
        call    LINK_BUSY_SET
        call    DSKIO_BODY
        jp      LINK_BUSY_CLR

DSKIO_BODY:
        JP      NC,DSKIO_READ

; START OF ----------------------------
; MSXPi DSKIO_WRITE Routine    |
;--------------------------------------
DSKIO_WRITE:
        cp      2
        jp      nc,DSKIO_ERR1

; save destination address and number of sectors to write
        push    bc               ; need to save this ?
        push    hl                ; save buffer address
        call    DSKIO_SECTINFO    ; Send sector info
        jp      c,DSKIO_ERR
        ld      de,DOS_WSEC
        call    SendCommandToMSXPi ; Send sector write command "DSKIOWRS"
        jp      c,DSKIO_ERR
        pop     de                ; buffer with data to read
        pop     bc                ; number of bytes to transfer
; Sectors normally go straight between the link and the caller's buffer.
; Only a sector that can touch page 1 (3E00-7FFF, where this ROM is mapped
; while the driver runs) is staged through the private buffer and XFER.
; Nextor never hands a legacy driver such an address - it remaps page 1 into
; page 2 first - so under Nextor every sector takes the direct path. Staging
; every sector through the page-3 buffer (R2/R2.1) broke COPY on a real
; Canon V-25 + MFR SD ("Bad file allocation table reading drive A:").
DSKIO_WRITE_LOOP:
        push    bc
        ld      a,d
        call    DSKIO_P1_TEST
        jr      c,DSKIO_WRITE_STAGED
        push    de
        call    DSKIO_TXSIZE       ; BC = 512, bit 15 set: send as a /WAIT burst
        call    SENDDATA
        pop     de
        inc     d                  ; DE += 512; INC keeps SENDDATA's carry
        inc     d
DSKIO_WRITE_NEXT:
        pop     bc
        jr      c,DSKIO_WRITE_ERR
        djnz    DSKIO_WRITE_LOOP
        or      a
        ret
DSKIO_WRITE_STAGED:
        ex      de,hl              ; HL = caller source
        call    DSKIO_BUFFER
        call    DSKIO_COPY_SECTOR   ; HL = next source, staged bytes in private buffer
        jr      c,DSKIO_WRITE_NEXT
        push    hl
        call    DSKIO_BUFFER
        call    DSKIO_TXSIZE
        call    SENDDATA
        pop     de                 ; original caller pointer, advanced 512
        jr      DSKIO_WRITE_NEXT
DSKIO_WRITE_ERR:
        jp      DSKIO_ERR1

; Return DE = the kernel's $SECBUF, which the DOS1 kernel documents as usable
; by the disk driver; preserve everything else. Only a caller buffer in page 1
; is staged, so the buffer is never also the caller's own buffer (page 3).
; The MSX-DOS1 kernel only allocates $SECBUF; Nextor fills it for boot and
; partition work, always as a direct target, never around a page-1 transfer
; through a legacy driver. Verified: Nextor SD <-> MSXPi COPY and FS-A1WSX
; internal floppy <-> MSXPi COPY, both directions, byte-identical.
DSKIO_BUFFER:
        ld      de,($SECBUF)
        ret

; Copy one staged sector to/from page 1. Only called for a page-1 caller
; buffer, so it always needs XFER, which runs from RAM, maps TPA RAM into
; page 1 and restores this ROM. DOS1 disables XFER in Disk BASIC, where page 1
; is the BASIC ROM and no transfer targets it; if it is ever missing here,
; fail the sector rather than copy nothing.
; In: HL=source, DE=destination. Out: both advanced, carry = error.
DSKIO_COPY_SECTOR:
        ld      bc,SECTORSIZE
        ld      a,(XFER)
        cp      0C3H
        scf
        ret     nz
        call    XFER
        or      a
        ret
; DSKIO_P1_TEST (CF = sector at D*256 can touch page 1) lives in a free gap of
; the kernel ROM: see dskio_p1test.asm.

; BC = sector size for SENDDATA, with bit 15 set when the last block the
; server sent was a /WAIT burst (RECVDATA_ONEBLOCK keeps its raw length high
; byte at work area +7). Only a server that can burst both ways sends one,
; and only when this side asked (DSKIO_RXSIZE, /WAIT present); disk reads
; always come before writes. SENDDATA sends only the first attempt as a
; burst. GETWRK keeps DE. Corrupts AF, HL, IX.
; DSKIO_TXSIZE lives in a free gap of the kernel ROM: see dskio_txsize.asm.

        INCLUDE dskio_rxsize.asm

; START OF ----------------------------
; MSXPi DSKIO_READ Routine     |
;--------------------------------------
; DSKIO
;
; Input:    A   Drivenumber
;       F   Cx reset for read
;           Cx set for write
;       B   number of sectors
;       C   Media descriptor
;       de  logical sectornumber
;       hl  transfer address
; Output:   F   Cx set for error
;           Cx reset for ok
;       A   if error, errorcode
;       B   if error, remaining sectors
; Changed:  af,bc,de,hl,IX,IY may be affected
;
DSKIO_READ:
        cp      2
        jr      nc,DSKIO_ERR1
; save destination address and number of sectors to write
        push    bc                ;
        push    hl                ; save buffer address
        call    DSKIO_SECTINFO    ; Send sector info
        jp      c,DSKIO_ERR
        ld      de,DOS_RSEC
        call    SendCommandToMSXPi ; Send sector read command "DSKIORDS"
        jp      c,DSKIO_ERR
        pop     de                ; buffer to write data from rpi
        pop     bc                ; number of bytes to transfer
DSKIO_READ_LOOP:
        push    af
        push    bc
        push    de                 ; caller destination survives reception
        ld      a,d
        call    DSKIO_P1_TEST      ; CF = page 1: receive into the private buffer
        push    af
        call    c,DSKIO_BUFFER
        call    DSKIO_RXSIZE       ; BC = 512, bit 15 set to ask for a /WAIT burst
        call    PerformHandshake
        jr      c,DSKIO_READ_RXEND
        xor     a
        call    RECVDATA_ONEBLOCK
DSKIO_READ_RXEND:
        pop     hl                 ; L = flags of the page-1 test
        pop     de                 ; caller destination
        jr      c,DSKIO_READ_DONE  ; do not copy a rejected sector
        bit     0,l
        jr      nz,DSKIO_READ_COPY
        inc     d                  ; direct: DE += 512
        inc     d
        jr      DSKIO_READ_DONE_OK
DSKIO_READ_COPY:
        ex      de,hl              ; HL = caller destination
        call    DSKIO_BUFFER       ; DE = private buffer
        ex      de,hl
        call    DSKIO_COPY_SECTOR
        jr      c,DSKIO_READ_DONE
DSKIO_READ_DONE_OK:
        or      a
DSKIO_READ_DONE:
        pop     bc
        pop     hl
        ld      a,h
        jr      c,DSKIO_ERR1
        djnz    DSKIO_READ_LOOP
        or      a
        ret
DSKIO_ERR:
        pop     hl
        pop     bc
DSKIO_ERR1:
        ld      a,12
        scf
        ret

; END OF ------------------------------
; MSXPi DSKIO_READ Routine     |
;--------------------------------------

; --- Claim / release the link for the disk --------------------------------
; Both preserve AF, BC, DE and HL, which matters at BOTH ends: on entry DSKIO
; takes the drive in A and read/write in the CARRY flag, and on exit it returns
; the error code in A and the carry.  IX is corrupted, which DSKIO's own
; contract already permits.
; SAVE and RESTORE, not set-and-clear.  A .COM can now hold the link itself
; through UNAPI routine 129, and such a program may well write to disk in the
; middle of its transfer - pcopy does exactly that with every block it
; receives.  Forcing the flag to 0 here would drop that program's claim while
; it was still using the link, letting the ISR back in precisely where it does
; the damage.  One save slot suffices: DSKIO is not reentrant.
LINK_BUSY_SET:
        push    af
        push    bc
        push    hl
        call    GETWRK              ; HL = IX = this driver's work area
        ld      a,(ix+o_LINK_BUSY)
        ld      (ix+o_LINK_SAVE),a
        ld      (ix+o_LINK_BUSY),1
        jr      LINK_BUSY_DONE
LINK_BUSY_CLR:
        push    af
        push    bc
        push    hl
        call    GETWRK
        ld      a,(ix+o_LINK_SAVE)
        ld      (ix+o_LINK_BUSY),a
LINK_BUSY_DONE:
        pop     hl
        pop     bc
        pop     af
        ret



; START OF ----------------------------
; MSXPi DSKIO_SECTINFO Routine |
;--------------------------------------
; DSKIO
;
; Input:    A   Drivenumber
;       F   Cx reset for read
;           Cx set for write
;       B   number of sectors
;       C   Media descriptor
;       de  logical sectornumber
;       hl  transfer address
; Output:   F   Cx set for error
;           Cx reset for ok
;       A   if error, errorcode
;       B   if error, remaining sectors
; Changed:  af,bc,de,hl,IX,IY may be affected
;
DSKIO_SECTINFO:
        push    de
        push    bc
        push	af
        LD      de,DOS_SECI
        call    SendCommandToMSXPi
        jr      nc,DSKIO_SECTINFO1
DSKIO_SEC_ERR:
        pop     af
        pop     bc
        pop	de
        scf
        ret
DSKIO_SECTINFO1:
	call	GETWRK
	pop	    af
	ld	    (hl),a
	inc	    hl
	pop	    bc
	ld	    (hl),b
	inc 	hl
	ld      (hl),c
	inc     hl
	pop     de
	ld      (hl),e
	inc     hl
	ld      (hl),d
	push	ix
	pop     de
	ld	    bc,5
	call	senddata
	; Propagate SENDDATA carry so DSKIO does not issue a command after failure.
	ret
        
; END OF ------------------------------
; MSXPi DSKIO_SECTINFO Routine |
;--------------------------------------

; DSKCHG
;
; Input: 	A	Drivenumber
; 		B	0
; 		C	Media descriptor
; 		hl	pointer to DPB
; Output:	F	Cx set for error
;			Cx reset for ok
;		A	if error, errorcode
;		B	if no error, disk change status
;			01 disk unchanged
;			00 unknown
;			FF disk changed
; Changed:	af,bc,de,hl,IX,IY may be affected
; Remark:	DOS1 kernel expects the DPB updated when disk change status is unknown or changed
;		DOS2 kernel does not care if the DPB is updated or not
DSKCHG:
        ld		b,00
        or		a
        ret

; Disk changed, must read sector and update DPB
DSKCHGDPB:
        ret

; GETDPB
;
; Input: 	A	Drivenumber
; 		B	first byte of FAT
; 		C	Media descriptor
; 		hl	pointer to DPB
; Output:	[hl+1]
;		..
;		[hl+18]	updated
; Changed:	af,bc,de,hl,IX,IY may be affected
; GETDPB
;
; Input: 	A	Drivenumber
; 		B	first byte of FAT
; 		C	Media descriptor
; 		hl	pointer to DPB
; Output:	[hl+1]
;		..
;		[hl+18]	updated
; Changed:	af,bc,de,hl,IX,IY may be affected
;
; DSKCHG always answers "unknown", so Nextor revalidates the drive whenever
; its media-check timer has lapsed: it re-reads the boot sector and then calls
; GETDPB. It arrives here with carry SET and treats a carry returned from
; GETDPB as failure - "Not a DOS disk". A bare RET handed that carry straight
; back, so COPY between MSXPi and another drive failed whenever the check
; happened mid-copy. Keep the DPB as it is (as before) but return carry clear.

GETDPB:
        xor     a
        ret

; The kernel copies 21 bytes from DEFDPB into every drive's DPB: one byte
; before the media id, the 18-byte F9 entry and the two bytes after it. Only
; the F9 entry is used (GETDPB leaves the DPB as initialised), so the F8
; entry that used to precede it is reduced to that one leading byte.
DpbTable:
		db	0		; DEFDPB byte 0 (was the last byte of the F8 entry)
		db	0F9h		; Media F9
		dw	512		; 80 Tracks
		db	0Fh		; 9 sectors
		db	04h		; 2 sides
		db	01h		; 3.5" 720 Kb
		db	02h
		dw	1
		db	2
		db	112
		dw	14
		dw	714
		db	3
		dw	7

DEFDPB	equ	DpbTable

; CHOICE
;
; Input: 	None
; Output:	hl	pointer to choice string, 0 if no choice
; Changed:	af,bc,de,hl,IX,IY may be affected

CHOICE:
		ld		hl,0
		ret

; DSKFMT
;
; Input: 	A	choicecode (1-9)
;		D	drivenumber
;		hl	begin of workarea
;		bc	length of workarea
; Output:	F	Cx set for error
;			Cx reset for ok
;		A	if error, errorcode
; Changed:	af,bc,de,hl,IX,IY may be affected

DSKFMT:
        scf
        ld      a,10
        ret


; MTOFF
;
; Input:    None
; Output:   None
; Changed:  af,bc,de,hl,IX,IY may be affected

DSKSTP:
MTOFF:
        ret

; OEMSTATEMENT
;
; Input:	hl	basicpointer
; Output:	F	Cx set if statement not recognized
;			Cx reset if statement is recognized
;		hl	basicpointer,	updated if recognized
;					unchanged if not recognized
; Changed:	af,bc,de,hl,IX,IY may be affected

OEMSTA:
        INCLUDE msxpi_call.asm

; ================================================================
; Text messages used in the loader
; ================================================================

MSXPIVERSION:
        DB      13,10,"MSXPi BIOS v1.6"
BuildId: DB ".20260919.059"
        DB      13,10
        DB      "    RCC (c) 2015-2026",13,10,0
; ================================================================
; Table of Commands available/implemented
; ================================================================
CALL_TABLE:
        DB      "MSXPIVER",0
        DW      _MSXPIVER
        DB      "MSXPI",0
        DW      _MSXPI
ENDOFCMDS:
        DB      00

; Commands for MSX-DOS - sector transfers.  The protocol also defines
; "dskioini", "dskiodrv" and "dskiofmt"; this driver never sends them, so
; they are not carried here - the space went to the UNAPI driver below.
; SendCommandToMSXPi sends up to the first 0: no padding needed.
DOS_RSEC:   DB  "dskior",0
DOS_WSEC:   DB  "dskiow",0
DOS_SECI:   DB  "dskios",0

INCLUDE include.asm
INCLUDE putchar_msxdos.asm
MSXPI_DRIVER    equ 1   ; msxpi_bios.asm: stash via the driver workarea (GETWRK)
INCLUDE msxpi_bios.asm

; ================================================================
; Ethernet UNAPI driver
; ================================================================
; Assembled separately by sjasm (software/UNAPI/src/ethrom.asm) and dropped in
; here as a binary, because the two builds cannot share one assembler: the
; driver is also built for a mapped RAM segment by the .COM installer, from
; the same sources, and those use sjasm syntax throughout.
;
; It is placed at a FIXED address rather than simply appended, so that both
; directions of overflow are build errors instead of silent corruption:
; MSXPi code growing past UNAPI_ORG, or the driver growing past the end of the
; ROM.  If either assertion fires, either free space here (there is a lot of
; comment-only ROM data left) or take the diagnostic routine 128 out of
; ethcore.asm.
;
; The driver calls two kernel entry points by hardcoded address, because zmac
; and sjasm have no way to share a symbol table.  Both live in the kernel half
; of msx-dos.mac, entirely below this point, so nothing here can move them -
; but assert it anyway, since the failure mode is a jump into whatever landed
; at the old address.
        ASSERT  GETSLT EQ 06016H         ; ethrom.asm GETSLT
        ASSERT  GETWRK EQ 06025H         ; ethrom.asm GETWRK

        ASSERT  $ LE UNAPI_ORG           ; MSXPi code has run into the driver
        DEFS    UNAPI_ORG-$,0
UNAPI_ROM_IMAGE:
        INCBIN  ethrom.bin
        ASSERT  $ LE 08000H              ; the driver has run off the ROM
